---
import { useTranslations, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-earth-800">
  <!-- Background gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-earth-800/90 via-earth-800/70 to-teal-700/60 z-10"></div>

  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10 z-0" style="background-image: radial-gradient(circle at 20% 50%, #2a9d8f 0%, transparent 50%), radial-gradient(circle at 80% 20%, #7a5c38 0%, transparent 50%)"></div>

  <!-- Content -->
  <div class="container relative z-20 text-center py-24 md:py-32">
    <!-- Tagline chip -->
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-teal-500/20 border border-teal-400/30 rounded-full text-teal-300 text-sm font-medium mb-8">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
        <path d="M4 9 Q8 3 12 9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
      New Zealand · Australia
    </div>

    <!-- Main heading -->
    <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl text-cream-50 mb-6 max-w-3xl mx-auto leading-tight">
      {t('hero.tagline')}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-cream-200 max-w-2xl mx-auto mb-12 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="https://calendly.com/harmonyimmigration/30min?primary_color=2a9d8f"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-base px-8 py-4 shadow-lg shadow-teal-900/30"
      >
        {t('hero.cta.book')}
      </a>
      <a
        href="#eligibility"
        class="btn-secondary text-base px-8 py-4 border-cream-200/40 text-cream-100 hover:bg-cream-50/10 hover:text-cream-50 hover:border-cream-200/70"
      >
        {t('hero.cta.assess')}
      </a>
    </div>

    <!-- Trust indicators -->
    <div class="mt-16 flex flex-wrap justify-center gap-8 text-cream-300 text-sm">
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M9 1L11.27 6.64H17.18L12.45 9.87L14.73 15.51L9 12.28L3.27 15.51L5.55 9.87L0.82 6.64H6.73L9 1Z" fill="#3dbfb2"/>
        </svg>
        Licensed Immigration Adviser
      </div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M9 1L11.27 6.64H17.18L12.45 9.87L14.73 15.51L9 12.28L3.27 15.51L5.55 9.87L0.82 6.64H6.73L9 1Z" fill="#3dbfb2"/>
        </svg>
        PhD in Law
      </div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M9 1L11.27 6.64H17.18L12.45 9.87L14.73 15.51L9 12.28L3.27 15.51L5.55 9.87L0.82 6.64H6.73L9 1Z" fill="#3dbfb2"/>
        </svg>
        Free 30-min Consultation
      </div>
      <div class="flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M9 1L11.27 6.64H17.18L12.45 9.87L14.73 15.51L9 12.28L3.27 15.51L5.55 9.87L0.82 6.64H6.73L9 1Z" fill="#3dbfb2"/>
        </svg>
        English · Magyar · Italiano · Deutsch
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 animate-bounce">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7" stroke="#f8efdf" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
    </svg>
  </div>
</section>
