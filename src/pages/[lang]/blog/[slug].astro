---
import BlogPost from '@layouts/BlogPost.astro';
import { useTranslations, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const langs: Lang[] = ['en', 'hu', 'it', 'de'];

  return langs.flatMap((lang) => {
    const langPosts = posts.filter(
      (p) => !p.data.draft && (p.data.locale === lang || (lang !== 'en' && p.data.locale === 'en'))
    );
    return langPosts.map((post) => {
      const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? post.id;
      return {
        params: { lang, slug },
        props: { post },
      };
    });
  });
}

const { post } = Astro.props;
const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { Content } = await render(post);

// Estimate reading time (~200 words per minute)
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const translations = Object.fromEntries(
  (['en', 'hu', 'it', 'de'] as Lang[]).map((l) => [
    l,
    `${SITE_URL}/${l}/blog/${slug}`,
  ])
) as Partial<Record<Lang, string>>;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
  },
};
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  translations={translations}
  canonicalUrl={`${SITE_URL}/${lang}/blog/${slug}`}
  schema={blogSchema}
  readingTime={readingTime}
>
  <Content />
</BlogPost>
