---
import Page from '@layouts/Page.astro';
import HeroSection from '@components/home/HeroSection.astro';
import CorePrinciplesSection from '@components/home/CorePrinciplesSection.astro';
import ServicesPreviewSection from '@components/home/ServicesPreviewSection.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import CtaSection from '@components/home/CtaSection.astro';
import { useTranslations, getAlternateUrls, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translations = getAlternateUrls('/');

// Build full URL translations for hreflang
const fullTranslations = Object.fromEntries(
  Object.entries(translations).map(([l, path]) => [l, `${SITE_URL}${path}`])
) as Partial<Record<Lang, string>>;
---

<Page
  title={t('hero.tagline')}
  description={t('meta.default_desc')}
  lang={lang}
  translations={fullTranslations}
  canonicalUrl={`${SITE_URL}/${lang}/`}
>
  <HeroSection lang={lang} />
  <CorePrinciplesSection lang={lang} />
  <ServicesPreviewSection lang={lang} />
  <TestimonialsSection lang={lang} />
  <CtaSection lang={lang} />
</Page>
