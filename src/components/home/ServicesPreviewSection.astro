---
import { getCollection } from 'astro:content';
import Icon from '@components/global/Icon.astro';

const allServices = await getCollection('services');
const services = allServices
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">What We Handle</span>
      <h2 class="mt-5">Immigration pathways, <br class="hidden md:block" />handled end to end.</h2>
      <p class="mt-5 text-lg">From a single work permit to a full family relocation, we cover the pathways that matter most.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, i) => (
        <a
          href={`/services/${service.data.slug}`}
          class="card reveal group flex flex-col p-8"
          style={`transition-delay:${i * 60}ms`}
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-cream-200)] text-[var(--color-ink-800)]">
            <Icon name={service.data.icon} class="w-6 h-6" />
          </div>
          <h3 class="mt-6">{service.data.title}</h3>
          <p class="mt-2 text-sm flex-1">{service.data.shortDesc}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-ink-800)] group-hover:gap-2.5 transition-all">
            Learn more
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn btn-dark">View All Services</a>
    </div>
  </div>
</section>
