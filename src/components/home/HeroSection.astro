---
const stats = [
  { value: '400+', label: 'People helped' },
  { value: '99%', label: 'Approval rate' },
  { value: '7 years', label: 'of practice' },
  {
    value: '5-star',
    label: 'Google review',
    href: 'https://www.google.com/search?q=harmony+immigration&rlz=1C1RXMK_enNZ948NZ948&oq=harmony+immigration&gs_lcrp=EgZjaHJvbWUqBwgAEAAYgAQyBwgAEAAYgAQyBwgBEAAYgAQyBwgCEAAYgAQyBwgDEAAYgAQyBwgEEAAYgAQyBwgFEAAYgAQyCggGEAAYgAQYtAcyBggHEAAYHjIGCAgQABgeMgYICRAAGB7SAQk5MDg1ajBqMTWoAgiwAgHxBd00l0aEMNvN8QXdNJdGhDDbzQ&sourceid=chrome&source=chrome.rb&ie=UTF-8#lrd=0x43747abc5e7073ef:0x701c5e396d8a8887,1,,,,',
  },
];
---

<section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32 bg-white">
  <div class="container relative z-10">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div class="reveal">
        <h1>
          Your immigration<br />
          plan can start with<br />
          <span class="text-[var(--color-ink-500)]">one conversation.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg text-[var(--color-heading)]">
          From visa strategy to settlement, we help you<br />
          make the move to New Zealand or Australia.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/contact" class="btn btn-primary">Book a Consultation</a>
          <a href="/services" class="btn btn-outline">Explore Services</a>
        </div>

        <div class="mt-32 grid grid-cols-4 gap-x-4 gap-y-8">
          {stats.map((s) => (
            s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="group block ml-8">
                <p class="font-display text-2xl font-semibold text-[var(--color-heading)] transition-colors group-hover:text-[var(--color-flame-500)] md:text-3xl">{s.value}</p>
                <p class="mt-1 text-xs text-[var(--color-neutral-600)] underline decoration-[var(--color-neutral-200)] underline-offset-2 group-hover:text-[var(--color-flame-500)]">{s.label}</p>
              </a>
            ) : (
              <div>
                <p class="font-display text-2xl font-semibold text-[var(--color-heading)] md:text-3xl">{s.value}</p>
                <p class="mt-1 text-xs text-[var(--color-neutral-600)]">{s.label}</p>
              </div>
            )
          ))}
        </div>
      </div>

      <div class="reveal relative" style="transition-delay: 120ms;">
        <div class="relative rounded-[2rem] bg-white p-3 shadow-[var(--shadow-glow)]">
          <div class="aspect-[4/5] w-full overflow-hidden rounded-[1.5rem] relative">
            <img
              src="/images/hero-conversation.jpg"
              alt="Two people talking during a consultation"
              class="absolute left-0 w-full object-cover"
              style="height: calc(100% + 28px); top: -14px; transform: translateY(10px);"
            />
            <div class="pointer-events-none absolute inset-0 bg-white" style="opacity: 0.13;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
