---
import Page from '@layouts/Page.astro';

const cards = [
  {
    icon: '/images/icons-more-than-visa/job-ready.svg',
    photo: '/images/job-ready-card.jpg',
    photoPosition: 'object-center',
    title: 'Job ready',
    desc: 'Finding work in a new country is a challenge on its own. We help you present your experience well and get in front of the right people:',
    checklist: ['CVs & cover letters', 'Employer connections', 'Interview preparation'],
    cta: 'Ask about Job Support',
  },
  {
    icon: '/images/icons-more-than-visa/english-prep.svg',
    photo: '/images/english-prep-card.png',
    photoPosition: 'object-[center_52%]',
    title: 'English prep',
    desc: "Visa interviews and language exams don't leave much room to guess. We help you practise for the real thing, so the day itself feels familiar:",
    checklist: ['IELTS & exam prep', 'Couples interview training'],
    cta: 'Ask about English Prep',
  },
  {
    icon: '/images/icons-more-than-visa/certified-translation.svg',
    photo: '/images/translation-card.jpg',
    photoPosition: 'object-[center_39.3%]',
    title: 'Translation',
    desc: 'NAATI and NZSTI accredited, so your documents are translated and certified. We also interpret when you need someone on your side:',
    checklist: ['Translating', 'Interpreting', 'Document certification'],
    cta: 'Ask about Translation',
  },
  {
    icon: '/images/icons-more-than-visa/setting-up-wrench.svg',
    photo: '/images/setting-up-card.png',
    photoPosition: 'object-[center_53.9%]',
    flip: true,
    zoom: 1.2075,
    shiftX: -50,
    title: 'Setting up',
    desc: 'Getting the visa is one milestone. Building an actual life here is the next. We help you work through those tasks:',
    checklist: ['Accommodation', 'Tenant rights', 'GP registration', 'Tax (IRD) enrolment', 'Opening a bank account', 'Transportation'],
    cta: 'Ask about Setting up',
  },
];

const faq = [
  {
    question: "Can you guarantee I'll find a job?",
    answer: 'No, and nobody honestly can. We help you present your experience and connect with employers, but the hiring decision is always theirs.',
  },
  {
    question: 'Do I need an IELTS result for my visa?',
    answer: "It depends on the visa and the role. Some require a test result, others don't. We'll tell you what applies to you before you pay for an exam.",
  },
  {
    question: 'Will immigration accept your translations?',
    answer: 'Requirements depend on the visa and the country, so we check what your application needs before we start.',
  },
  {
    question: 'How long does a translation take?',
    answer: "It depends on how many documents there are and how long they are. We'll give you a timeframe before we begin.",
  },
  {
    question: 'Can I use these services before I arrive?',
    answer: "Yes, some things make sense to sort out before you arrive and some don't. For example, arranging accommodation and knowing what to set up first is a good idea.",
  },
  {
    question: 'Do I need to be a client for immigration advice to use these?',
    answer: 'No, these stand on their own, with or without us handling your visa.',
  },
  {
    question: 'Can I use more than one of these at once?',
    answer: 'Yes, most people end up needing two or three together.',
  },
  {
    question: 'Do these cost extra on top of visa advice?',
    answer: "Yes, we'll always be upfront about cost before you commit to anything.",
  },
];
const faqCol1 = faq.slice(0, 4);
const faqCol2 = faq.slice(4, 8);

const pathwayLinks = [
  { label: 'Individuals', href: '/services' },
  { label: 'Families', href: '/families' },
  { label: 'Businesses', href: '/businesses' },
];
---

<Page
  title="Settling in takes more than a visa"
  description="Job readiness, English preparation, certified translation and settling-in support for after your visa is approved."
>
  <section class="relative overflow-hidden pb-16 pt-[94px] md:pt-[126px]" style="background: white;">
    <div class="absolute inset-0 bg-cover" style="background-image: url('/images/settling-in-banner.png'); background-position: center 35%;"></div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(255,255,255,0.97) 0%, rgba(255,255,255,0.9) 35%, rgba(255,255,255,0.35) 65%, rgba(255,255,255,0) 100%);"></div>
    <div class="container relative z-10 reveal pl-[53px] -mt-[50px]">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold mb-6" style="color:#55BFC0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
      </a>
      <h1 class="mt-6 text-4xl sm:text-5xl">Settling in takes<br />more than a visa</h1>
      <p class="mt-5 max-w-lg text-lg">We support you in four key areas to build your life here.</p>
    </div>
  </section>

  <section class="pb-20 pt-px" style="background: white;">
    <div class="container">
      <div class="relative z-10 mt-[47px] grid gap-6 sm:grid-cols-2">
        {cards.map((card, i) => (
          <div class="card card-deep-shadow reveal relative overflow-hidden" style={`transition-delay:${i * 70}ms; border: 0.7px solid rgba(18, 59, 87, 0.2);`}>
            <div class="relative h-[180px] w-full overflow-hidden">
              <img src={card.photo} alt="" class={`h-full w-full object-cover ${card.photoPosition}`} style={(() => {
                const transforms = [];
                if (card.flip) transforms.push('scaleX(-1)');
                if (card.zoom) transforms.push(`scale(${card.zoom})`);
                // translateX goes outermost (first) so its px value is the exact
                // final on-screen shift, unaffected by the scale/flip above.
                if (card.shiftX) transforms.unshift(`translateX(${card.shiftX}px)`);
                return transforms.length ? `transform: ${transforms.join(' ')};` : undefined;
              })()} />
            </div>
            <div class="absolute top-[134px] left-7 z-10 flex h-[72px] w-[72px] items-center justify-center rounded-full bg-white">
              <img src={card.icon} alt="" class="h-[52.8px] w-[52.8px]" />
            </div>
            <div class="p-7 pt-9">
              <h3 class="tracking-tight">{card.title}</h3>
              <p class="mt-2 text-[#123B57]">{card.desc}</p>
              <ul class={`mt-4 grid gap-x-6 gap-y-1 text-sm text-[#123B57] ${card.checklist.length > 3 ? 'sm:grid-cols-2' : ''}`}>
                {card.checklist.map((item) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-[var(--color-flame-500)]" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a href="/contact" class="mt-11 inline-flex items-center gap-1.5 text-base font-semibold" style="color:#55BFC0;">
                {card.cta}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="reveal mx-auto mt-16 flex max-w-[942px] flex-col items-start gap-6 rounded-[var(--radius-xl)] bg-[#123B57] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <div>
          <p class="text-lg font-semibold text-white">Not sure which of these you actually need?</p>
          <p class="mt-2 text-lg text-white/80">Tell us where you're at and we'll help you work out your next step.</p>
        </div>
        <a href="/contact" class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">Send a message</a>
      </div>
    </div>
  </section>

  <section class="bg-white pt-28 pb-20">
    <div class="container">
      <h2>Have questions?</h2>
      <div class="mt-6 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        <div class="space-y-4">
          {faqCol1.map((item) => (
            <details class="faq-details">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[#123B57]">
                {item.question}
                <span class="faq-icon shrink-0 text-2xl leading-none text-[#123B57]">+</span>
              </summary>
              <p class="mt-2 italic text-[#123B57]">{item.answer}</p>
            </details>
          ))}
        </div>
        <div class="space-y-4">
          {faqCol2.map((item) => (
            <details class="faq-details">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[#123B57]">
                {item.question}
                <span class="faq-icon shrink-0 text-2xl leading-none text-[#123B57]">+</span>
              </summary>
              <p class="mt-2 italic text-[#123B57]">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pt-16 pb-0 -mb-[4px] bg-white md:mb-0 md:pb-[28px]">
    <div class="reveal w-full overflow-hidden bg-cover bg-right py-10" style="background-image: url('/images/coastal-path.png');">
      <div class="container flex flex-col gap-6">
        <div>
          <p class="text-lg font-semibold text-[#123B57]">Looking for a visa pathway instead?</p>
          <p class="mt-2 text-[#123B57]">Explore options for individuals, families or businesses.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {pathwayLinks.map((link) => (
            <a href={link.href} class="btn flex-none inline-flex items-center gap-2" style="background:#55BFC0; border-color:#55BFC0; color:white;">
              {link.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .faq-details summary {
    list-style: none;
  }
  .faq-details summary::-webkit-details-marker {
    display: none;
  }
  .faq-details .faq-icon {
    transition: transform 0.2s ease;
  }
  .faq-details[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>
