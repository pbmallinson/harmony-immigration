---
import Page from './Page.astro';
import type { Lang } from '@i18n/utils';
import { useTranslations, getLocalePath } from '@i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  coverImage?: string;
  coverImageAlt?: string;
  translations?: Partial<Record<Lang, string>>;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  readingTime?: number;
}

const {
  title,
  description,
  lang,
  publishDate,
  updatedDate,
  author = 'Dr Edit Fellner-Andrejkovics',
  tags = [],
  coverImage,
  coverImageAlt = '',
  translations,
  schema,
  readingTime,
} = Astro.props;

const t = useTranslations(lang);

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-NZ' : lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Page
  title={title}
  description={description}
  lang={lang}
  translations={translations}
  schema={schema}
>
  <article class="py-16">
    <div class="container max-w-3xl">
      <!-- Tags -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map((tag) => (
            <span class="text-xs font-semibold px-3 py-1 bg-teal-500/10 text-teal-700 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h1 class="section-heading mb-4">{title}</h1>

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted mb-8 pb-8 border-b border-cream-200">
        {publishDate && (
          <time datetime={publishDate.toISOString()}>
            {dateFormatter.format(publishDate)}
          </time>
        )}
        {updatedDate && (
          <span class="text-text-light">
            (Updated: <time datetime={updatedDate.toISOString()}>{dateFormatter.format(updatedDate)}</time>)
          </span>
        )}
        <span>·</span>
        <span>{t('blog.by')} {author}</span>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime} {t('blog.min_read')}</span>
          </>
        )}
      </div>

      <!-- Cover image -->
      {coverImage && (
        <div class="rounded-xl overflow-hidden mb-10 aspect-video">
          <img src={coverImage} alt={coverImageAlt} class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
      )}

      <!-- Content -->
      <div class="prose-content">
        <slot />
      </div>

      <!-- Back link -->
      <div class="mt-12 pt-8 border-t border-cream-200">
        <a href={getLocalePath('/blog', lang)} class="btn-secondary text-sm">
          ← {t('blog.readmore').replace('Read article', 'Back to Blog').replace('Cikk olvasása', 'Vissza a bloghoz').replace("Leggi l'articolo", 'Torna al blog').replace('Artikel lesen', 'Zurück zum Blog')}
        </a>
      </div>
    </div>
  </article>
</Page>
