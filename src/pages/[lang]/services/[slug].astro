---
import BlogPost from '@layouts/BlogPost.astro';
import CtaSection from '@components/home/CtaSection.astro';
import { useTranslations, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const langs: Lang[] = ['en', 'hu', 'it', 'de'];

  return langs.flatMap((lang) => {
    const langServices = services.filter(
      (s) => s.data.locale === lang || (lang !== 'en' && s.data.locale === 'en')
    );
    return langServices.map((service) => ({
      params: { lang, slug: service.data.slug },
      props: { service },
    }));
  });
}

const { service } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const { Content } = await render(service);

const translations = Object.fromEntries(
  (['en', 'hu', 'it', 'de'] as Lang[]).map((l) => [
    l,
    `${SITE_URL}/${l}/services/${service.data.slug}`,
  ])
) as Partial<Record<Lang, string>>;
---

<BlogPost
  title={service.data.title}
  description={service.data.shortDesc}
  lang={lang}
  translations={translations}
  canonicalUrl={`${SITE_URL}/${lang}/services/${service.data.slug}`}
>
  <Content />
</BlogPost>
