---
import Page from '@layouts/Page.astro';
import { useTranslations, getAlternateUrls, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translations = getAlternateUrls('/testimonials');

const fullTranslations = Object.fromEntries(
  Object.entries(translations).map(([l, path]) => [l, `${SITE_URL}${path}`])
) as Partial<Record<Lang, string>>;

const allTestimonials = await getCollection('testimonials');
const avgRating = allTestimonials.reduce((sum, t) => sum + t.data.rating, 0) / allTestimonials.length;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Harmony Immigration Ltd',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avgRating.toFixed(1),
    reviewCount: allTestimonials.length,
    bestRating: '5',
    worstRating: '1',
  },
  review: allTestimonials.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.data.name },
    reviewRating: { '@type': 'Rating', ratingValue: t.data.rating },
    reviewBody: t.data.text,
    datePublished: t.data.date.toISOString().split('T')[0],
  })),
};
---

<Page
  title={t('testimonials.title')}
  description={`${allTestimonials.length} five-star reviews from Harmony Immigration clients. ${t('testimonials.subtitle')}`}
  lang={lang}
  translations={fullTranslations}
  canonicalUrl={`${SITE_URL}/${lang}/testimonials`}
  schema={aggregateSchema}
>
  <!-- Header -->
  <div class="bg-earth-800 py-20">
    <div class="container text-center">
      <div class="flex justify-center gap-1 mb-4">
        {Array.from({ length: 5 }).map(() => (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#3dbfb2" aria-hidden="true">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
          </svg>
        ))}
      </div>
      <h1 class="font-heading text-5xl text-cream-50 mb-4">{t('testimonials.title')}</h1>
      <p class="text-cream-200 text-lg max-w-xl mx-auto">{t('testimonials.subtitle')}</p>
      <p class="text-teal-300 text-sm mt-3 font-medium">
        {allTestimonials.length} reviews · Average: {avgRating.toFixed(1)}/5
      </p>
    </div>
  </div>

  <!-- Testimonials grid -->
  <section class="py-20">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allTestimonials.map((testimonial) => (
          <div class="card p-7 flex flex-col gap-4">
            <!-- Stars -->
            <div class="flex gap-1" aria-label={`${testimonial.data.rating} out of 5 stars`}>
              {Array.from({ length: testimonial.data.rating }).map(() => (
                <svg width="18" height="18" viewBox="0 0 18 18" fill="#2a9d8f" aria-hidden="true">
                  <path d="M9 1L11.27 6.64H17.18L12.45 9.87L14.73 15.51L9 12.28L3.27 15.51L5.55 9.87L0.82 6.64H6.73L9 1Z"/>
                </svg>
              ))}
            </div>

            <!-- Quote -->
            <blockquote class="text-text-base leading-relaxed flex-1 text-sm">
              "{testimonial.data.text}"
            </blockquote>

            <!-- Attribution -->
            <div class="flex items-center justify-between pt-3 border-t border-cream-100">
              <div>
                <p class="font-semibold text-earth-800 text-sm">{testimonial.data.name}</p>
                {testimonial.data.location && (
                  <p class="text-text-light text-xs">{testimonial.data.location}</p>
                )}
              </div>
              <div class="text-right">
                <span class="text-xs text-text-light bg-cream-50 px-2 py-1 rounded block">
                  {t(`testimonials.source.${testimonial.data.source}`)}
                </span>
                <time class="text-xs text-text-light" datetime={testimonial.data.date.toISOString()}>
                  {new Intl.DateTimeFormat('en-NZ', { year: 'numeric', month: 'short' }).format(testimonial.data.date)}
                </time>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center bg-cream-50 rounded-2xl p-12">
        <h2 class="section-heading mb-4">Ready to write your own success story?</h2>
        <p class="text-text-muted max-w-lg mx-auto mb-8">Join hundreds of families who trusted Harmony Immigration with their most important journey.</p>
        <a href="https://calendly.com/harmonyimmigration/30min?primary_color=2a9d8f" target="_blank" rel="noopener noreferrer" class="btn-primary">
          {t('nav.book')}
        </a>
      </div>
    </div>
  </section>
</Page>
