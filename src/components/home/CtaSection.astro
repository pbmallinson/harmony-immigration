---
import { useTranslations, getLocalePath, type Lang } from '@i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 bg-teal-600" id="eligibility">
  <div class="container text-center">
    <h2 class="font-heading text-4xl md:text-5xl text-cream-50 mb-5">
      {t('cta.title')}
    </h2>
    <p class="text-teal-100 text-lg max-w-xl mx-auto mb-10 leading-relaxed">
      {t('cta.subtitle')}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="https://calendly.com/harmonyimmigration/30min?primary_color=2a9d8f"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 bg-cream-50 text-teal-700 font-semibold rounded-lg hover:bg-white transition-colors shadow-md"
      >
        {t('cta.book')}
      </a>
      <a
        href={getLocalePath('/contact', lang)}
        class="inline-flex items-center justify-center px-8 py-4 border-2 border-cream-50/50 text-cream-50 font-semibold rounded-lg hover:bg-teal-700/30 transition-colors"
      >
        {t('cta.assess')}
      </a>
    </div>
  </div>
</section>
