---
const credentials = [
  {
    icon: '/images/icons-about/nz.svg',
    title: 'NZ Licensed',
    detail: 'Immigration Adviser',
    code: 'LIA 202001046',
  },
  {
    icon: '/images/icons-about/australia.svg',
    title: 'Australia Registered',
    detail: 'Migration Agent',
    code: 'MARN 2418597',
  },
  {
    icon: '/images/icons-about/certified.svg',
    title: 'Certified',
    titleSecondary: 'English translator',
    detail: 'Hungarian interpreter',
  },
  {
    icon: '/images/icons-about/education.svg',
    title: 'PhD in Law',
    detail: 'Formal legal education',
  },
];
---

<section class="overflow-hidden bg-white py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-3xl mx-auto text-center">
      <h2>Meet your adviser</h2>
      <p class="mt-5 text-lg sm:whitespace-nowrap">Get to know the person behind the business and the experience she brings.</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-8">
      <div class="reveal lg:ml-[216px] lg:mt-9 lg:max-w-[320px]">
        <h3>Hello, I'm Edit.</h3>
        <p class="mt-5">I made the move to New Zealand myself, so I know the immigration process from both sides. Today, I help individuals, families and businesses understand their options and work out what comes next with clear, practical advice.</p>
        <p class="mt-24 text-[var(--color-heading)]">Want to ask something directly first?</p>
        <a href="/contact#contact-form" class="btn btn-primary mt-3">Send a message</a>
      </div>

      <div class="reveal">
        <img
          src="/images/team/edit-green-circle-bw.png"
          alt="Dr Edit Fellner-Andrejkovics"
          class="mx-auto w-full max-w-sm"
        />
        <div class="mx-auto mt-5 w-full max-w-sm text-center">
          <p class="font-display text-lg font-semibold text-[var(--color-heading)]">Dr Edit Fellner-Andrejkovics</p>
          <p class="mt-1 text-sm text-[var(--color-heading)]">Licensed Immigration Adviser<br />and Registered Migration Agent</p>
        </div>
      </div>
    </div>

    <div class="relative mt-16 grid grid-cols-2 gap-x-6 gap-y-10 lg:ml-[184px] lg:mr-[76px] lg:grid-cols-4 lg:gap-x-0">
      <div class="pointer-events-none absolute top-1 bottom-1 hidden w-px bg-[#123B57]/25 lg:block" style="left: calc(25% - 10px);"></div>
      <div class="pointer-events-none absolute top-1 bottom-1 hidden w-px bg-[#123B57]/25 lg:block" style="left: calc(50% - 10px);"></div>
      <div class="pointer-events-none absolute top-1 bottom-1 hidden w-px bg-[#123B57]/25 lg:block" style="left: calc(75% - 10px);"></div>
      {credentials.map((c) => (
        <div class="reveal lg:px-8">
          <img src={c.icon} alt="" class="h-12 w-12" />
          <p class="mt-3 font-bold text-[var(--color-heading)]">{c.title}</p>
          {c.titleSecondary && <p class="leading-snug text-[var(--color-heading)]">{c.titleSecondary}</p>}
          {c.detail && <p class="mt-0.5 leading-snug text-[var(--color-heading)]">{c.detail}</p>}
          {c.code && <p class="mt-0.5 leading-snug text-[var(--color-heading)]">{c.code}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
