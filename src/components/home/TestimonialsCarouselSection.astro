---
import { getCollection } from 'astro:content';

const all = await getCollection('testimonials');
const testimonials = all.slice(0, 6);

const initials = (name: string) =>
  name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---

<section class="relative overflow-hidden bg-[var(--color-ink-950)] py-24 md:py-32">
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[#55BFC0]/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-[#55BFC0]/10 blur-3xl"></div>

  <div class="container relative z-10">
    <div class="reveal max-w-2xl mx-auto text-center">
      <span class="eyebrow !text-[#94BFCD]">Client Stories</span>
      <h2 class="mt-5 !text-white">Real outcomes, in their own words.</h2>
    </div>

    <div class="reveal relative mx-auto mt-16 max-w-2xl" data-carousel>
      <svg class="mx-auto h-10 w-10 text-[#55BFC0]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-4v-10h9.999z"/>
      </svg>

      <div class="relative mt-8 min-h-[280px] sm:min-h-[260px]">
        {testimonials.map((t, i) => (
          <div
            class="carousel-slide absolute inset-0 flex flex-col items-center text-center transition-all duration-700 ease-out"
            data-slide
            data-index={i}
            style={i === 0 ? 'opacity:1; transform:translateY(0); pointer-events:auto;' : 'opacity:0; transform:translateY(12px); pointer-events:none;'}
          >
            <div class="flex gap-1 text-[#55BFC0]">
              {Array.from({ length: t.data.rating }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="font-display mt-5 text-xl leading-relaxed text-white sm:text-2xl">"{t.data.text}"</p>
            <div class="mt-7 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-full border border-[#55BFC0]/50 bg-[#55BFC0]/15 text-xs font-semibold text-[#94BFCD]">
                {initials(t.data.name)}
              </div>
              <div class="text-left">
                <p class="text-sm font-semibold text-white">{t.data.name}</p>
                <p class="text-xs text-[#94BFCD]">{t.data.outcome ?? t.data.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <button type="button" class="carousel-prev absolute left-[-3rem] top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-white/5 p-2 text-white transition-colors hover:bg-white/15 md:flex" aria-label="Previous testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="carousel-next absolute right-[-3rem] top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-white/5 p-2 text-white transition-colors hover:bg-white/15 md:flex" aria-label="Next testimonial">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="mt-10 flex items-center justify-center gap-2">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class="carousel-dot h-2 rounded-full bg-white/25 transition-all duration-300"
            style={i === 0 ? 'width:20px; background-color:#55BFC0;' : 'width:8px;'}
            data-dot
            data-index={i}
            aria-label={`Go to testimonial ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll('[data-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-dot]'));
    const prevBtn = carousel.querySelector('.carousel-prev');
    const nextBtn = carousel.querySelector('.carousel-next');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        (slide as HTMLElement).style.opacity = active ? '1' : '0';
        (slide as HTMLElement).style.transform = active ? 'translateY(0)' : 'translateY(12px)';
        (slide as HTMLElement).style.pointerEvents = active ? 'auto' : 'none';
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        (dot as HTMLElement).style.width = active ? '20px' : '8px';
        (dot as HTMLElement).style.backgroundColor = active ? '#55BFC0' : 'rgba(255,255,255,0.25)';
      });
    }

    function next() { show(current + 1); }
    function prev() { show(current - 1); }

    function start() {
      timer = setInterval(next, 5000);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number((dot as HTMLElement).dataset.index));
        stop();
        start();
      });
    });
    nextBtn?.addEventListener('click', () => { next(); stop(); start(); });
    prevBtn?.addEventListener('click', () => { prev(); stop(); start(); });

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);

    start();
  });
</script>
