---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'Work Visas', href: '/services/work-visas' },
      { label: 'Family & Partner Visas', href: '/services/family-partner-visas' },
      { label: 'Business & Investment', href: '/services/business-investor-visas' },
      { label: 'Residence & Citizenship', href: '/services/residence-citizenship' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Testimonials', href: '/testimonials' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<footer class="relative overflow-hidden bg-[var(--color-ink-950)] text-white">
  <div class="container relative z-10 pt-20 pb-10">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <a href="/" class="flex items-center mb-4">
          <img
            src="/logo-white.svg"
            alt="Harmony Immigration Services"
            class="h-[72px] w-auto"
          />
        </a>
        <p class="max-w-xs text-sm text-white">
          NZ & Australia, Together we get you there
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="text-sm font-semibold text-white mb-4">{col.title}</h4>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/60 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Get in touch</h4>
        <ul class="space-y-3 text-sm text-white/60">
          <li>48 Holdens Road, Henderson, Auckland 0612</li>
          <li>info@harmony-immigration.com</li>
          <li>+64 21 270 4860</li>
        </ul>
        <div class="mt-4 flex gap-3">
          <a
            href="https://www.facebook.com/profile.php?id=100063787283052"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Harmony Immigration on Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-white/70 transition-colors hover:border-white/40 hover:text-white"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.475h-1.26c-1.243 0-1.63.775-1.63 1.57v1.888h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94Z"/></svg>
          </a>
          <a
            href="https://www.linkedin.com/company/harmony-immigration"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Harmony Immigration on LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-white/70 transition-colors hover:border-white/40 hover:text-white"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.06 2.06 0 1 1 0-4.121 2.06 2.06 0 0 1 0 4.121ZM7.114 20.452H3.559V9h3.555v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col-reverse items-center justify-between gap-4 border-t border-white/10 pt-8 md:flex-row">
      <p class="text-xs text-white/40">© {year} Harmony Immigration Services. All rights reserved. Some imagery created with <a href="https://magnific.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-white/70">Magnific</a>.</p>
      <div class="flex gap-5 text-xs text-white/40">
        <a href="/privacy-policy" class="hover:text-white/70">Privacy Policy</a>
        <a href="/privacy-policy" class="hover:text-white/70">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
