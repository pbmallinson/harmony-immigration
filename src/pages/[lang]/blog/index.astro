---
import Page from '@layouts/Page.astro';
import { useTranslations, getAlternateUrls, getLocalePath, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translations = getAlternateUrls('/blog');

const fullTranslations = Object.fromEntries(
  Object.entries(translations).map(([l, path]) => [l, `${SITE_URL}${path}`])
) as Partial<Record<Lang, string>>;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => {
    const locale = p.data.locale;
    return (locale === lang || (lang !== 'en' && locale === 'en')) && !p.data.draft;
  })
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-NZ' : lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Page
  title={t('blog.title')}
  description={t('blog.subtitle')}
  lang={lang}
  translations={fullTranslations}
  canonicalUrl={`${SITE_URL}/${lang}/blog`}
>
  <!-- Header -->
  <div class="bg-earth-800 py-20">
    <div class="container text-center">
      <h1 class="font-heading text-5xl text-cream-50 mb-4">{t('blog.title')}</h1>
      <p class="text-cream-200 text-lg max-w-xl mx-auto">{t('blog.subtitle')}</p>
    </div>
  </div>

  <!-- Posts -->
  <section class="py-20">
    <div class="container max-w-4xl">
      {posts.length === 0 ? (
        <div class="text-center py-20 text-text-muted">
          <p class="text-lg">No posts yet — check back soon.</p>
        </div>
      ) : (
        <div class="space-y-8">
          {posts.map((post) => {
            // Extract slug from the entry id (e.g. "en/my-post" → "my-post")
            const slug = post.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') ?? post.id;
            return (
              <article class="card p-8 hover:shadow-md transition-shadow">
                <div class="flex flex-wrap gap-2 mb-4">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs font-medium px-2.5 py-1 bg-teal-500/10 text-teal-700 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="font-heading text-2xl text-earth-800 mb-3 hover:text-teal-600 transition-colors">
                  <a href={getLocalePath(`/blog/${slug}`, lang)}>{post.data.title}</a>
                </h2>
                <p class="text-text-muted leading-relaxed mb-5">{post.data.description}</p>
                <div class="flex items-center justify-between">
                  <div class="text-sm text-text-light">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {dateFormatter.format(post.data.publishDate)}
                    </time>
                    <span class="mx-2">·</span>
                    {post.data.author}
                  </div>
                  <a href={getLocalePath(`/blog/${slug}`, lang)} class="text-teal-600 text-sm font-semibold hover:underline">
                    {t('blog.readmore')} →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Page>
