---
import Page from '@layouts/Page.astro';
import { useTranslations, getAlternateUrls, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translations = getAlternateUrls('/events');

const fullTranslations = Object.fromEntries(
  Object.entries(translations).map(([l, path]) => [l, `${SITE_URL}${path}`])
) as Partial<Record<Lang, string>>;

const allEvents = await getCollection('events');
const now = new Date();

const upcoming = allEvents
  .filter((e) => !e.data.draft && e.data.eventDate >= now &&
    (e.data.locale === lang || (lang !== 'en' && e.data.locale === 'en')))
  .sort((a, b) => a.data.eventDate.valueOf() - b.data.eventDate.valueOf());

const past = allEvents
  .filter((e) => !e.data.draft && e.data.eventDate < now &&
    (e.data.locale === lang || (lang !== 'en' && e.data.locale === 'en')))
  .sort((a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat(lang === 'en' ? 'en-NZ' : lang, {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Page
  title={t('events.title')}
  description={t('events.subtitle')}
  lang={lang}
  translations={fullTranslations}
  canonicalUrl={`${SITE_URL}/${lang}/events`}
>
  <!-- Header -->
  <div class="bg-earth-800 py-20">
    <div class="container text-center">
      <h1 class="font-heading text-5xl text-cream-50 mb-4">{t('events.title')}</h1>
      <p class="text-cream-200 text-lg max-w-xl mx-auto">{t('events.subtitle')}</p>
    </div>
  </div>

  <section class="py-20">
    <div class="container max-w-3xl">
      {upcoming.length === 0 ? (
        <div class="text-center py-16">
          <div class="w-16 h-16 bg-cream-100 rounded-full flex items-center justify-center mx-auto mb-5">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#9a9a9a" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="22" height="20" rx="3"/>
              <path d="M9 3v4M19 3v4M3 11h22" stroke-linecap="round"/>
            </svg>
          </div>
          <p class="text-text-muted text-lg">{t('events.none')}</p>
          <p class="text-text-light text-sm mt-2">Follow us on LinkedIn or Facebook for announcements.</p>
          <div class="flex gap-3 justify-center mt-6">
            <a href="https://www.linkedin.com/company/harmony-immigration" target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">LinkedIn</a>
            <a href="https://www.facebook.com/profile.php?id=100063787283052" target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">Facebook</a>
          </div>
        </div>
      ) : (
        <div class="space-y-6">
          {upcoming.map((event) => (
            <div class="card p-7">
              <div class="flex flex-wrap gap-3 mb-3">
                <span class="text-xs font-medium px-2.5 py-1 bg-teal-500/10 text-teal-700 rounded-full">
                  {dateFormatter.format(event.data.eventDate)}
                </span>
                {event.data.isOnline && (
                  <span class="text-xs font-medium px-2.5 py-1 bg-earth-600/10 text-earth-600 rounded-full">
                    {t('events.online')}
                  </span>
                )}
              </div>
              <h2 class="font-heading text-xl text-earth-800 mb-2">{event.data.title}</h2>
              <p class="text-text-muted text-sm leading-relaxed mb-4">{event.data.description}</p>
              {event.data.location && !event.data.isOnline && (
                <p class="text-sm text-text-light mb-4">📍 {event.data.location}</p>
              )}
              {event.data.registrationUrl && (
                <a href={event.data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">
                  {t('events.register')}
                </a>
              )}
            </div>
          ))}
        </div>
      )}

      {past.length > 0 && (
        <details class="mt-12">
          <summary class="cursor-pointer font-semibold text-earth-800 mb-6 list-none flex items-center gap-2 hover:text-teal-600 transition-colors">
            {t('events.past')} ({past.length})
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform details-open:rotate-180" aria-hidden="true">
              <path d="M3 5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="space-y-4 opacity-60">
            {past.map((event) => (
              <div class="bg-cream-50 rounded-xl p-5">
                <p class="text-xs text-text-light mb-1">{dateFormatter.format(event.data.eventDate)}</p>
                <h3 class="font-medium text-earth-800">{event.data.title}</h3>
              </div>
            ))}
          </div>
        </details>
      )}
    </div>
  </section>
</Page>
