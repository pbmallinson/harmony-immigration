---
const categories = [
  {
    label: 'Individuals',
    tagline: 'Visit, work or study',
    desc: "Documents, details, deadlines.<br class=\"hidden lg:inline\" /> We've got it covered from start to finish.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;⟶",
    photo: '/images/individuals.jpg',
  },
  {
    label: 'Families',
    tagline: 'Together for good',
    desc: 'When you have a plan and a lot of questions.<br class="hidden lg:inline" /> We’ll help make sense of the immigration part.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;⟶',
    photo: '/images/families.jpg',
    position: 'object-[50%_15%]',
  },
  {
    label: 'Businesses',
    tagline: 'Grow without borders',
    desc: 'Supporting businesses to hire foreign<br class="hidden lg:inline" /> talents through accreditation and sponsorship.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;⟶',
    photo: '/images/businesses.jpg',
  },
];
---

<section class="py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-3xl mx-auto text-center">
      <h2>How we can help</h2>
      <p class="mt-5 text-lg sm:whitespace-nowrap">Everyone has a different reason for relocating and their own questions too. We're here to answer them.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      {categories.map((c, i) => (
        <a
          href="/services"
          class="card reveal group relative aspect-[3/4] w-full overflow-hidden p-0"
          style={`transition-delay:${i * 80}ms`}
        >
          <img
            src={c.photo}
            alt={c.label}
            class={`absolute inset-0 h-full w-full object-cover ${c.position ?? 'object-center'} transition-transform duration-500 group-hover:scale-105`}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 to-black/0 to-50%"></div>

          <div class="absolute inset-x-0 bottom-0 flex flex-col items-start gap-3 p-6 sm:p-8 lg:px-5 lg:py-8">
            <div
              class="inline-flex w-fit items-center rounded-xl border border-white/40 px-4 py-2 shadow-sm"
              style="background: rgba(255,255,255,0.18); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"
            >
              <span class="font-display text-sm font-semibold tracking-wide text-white">{c.label}</span>
            </div>

            <h3 class="text-white">{c.tagline}</h3>
            <p class="text-sm text-white/80" set:html={c.desc} />
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn" style="background:#123B57; border-color:#123B57; color:white;">Explore More</a>
    </div>

    <div class="reveal mt-16 flex flex-col items-start gap-6 rounded-[var(--radius-xl)] bg-[#123B57] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <p class="text-lg font-medium text-white sm:whitespace-nowrap">
        Not sure which visa is right for you because your situation doesn't fit into one category? That's normal.
      </p>
      <a href="/contact" class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">Get Started</a>
    </div>
  </div>
</section>
