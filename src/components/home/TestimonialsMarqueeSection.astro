---
import { getCollection } from 'astro:content';

const all = await getCollection('testimonials');
const testimonials = all;
const track = [...testimonials, ...testimonials];

const initials = (name: string) =>
  name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 45s linear infinite;
  }
  .marquee-viewport:hover .marquee-track,
  .marquee-viewport.is-paused .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<section class="relative overflow-hidden bg-[var(--color-cream-100)] py-24 md:py-32">
  <img
    src="/images/testimonials/section-bg.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="absolute inset-0 bg-[var(--color-cream-100)]/85"></div>

  <div class="container relative z-10">
    <div class="reveal max-w-2xl mx-auto text-center">
      <h2>What clients say</h2>
      <p class="mt-5 text-lg">A few words from people we've had the pleasure of helping.</p>
    </div>
  </div>

  <div class="reveal relative z-10 mt-10">
    <div class="marquee-viewport relative overflow-hidden pt-6 pb-14" data-marquee-viewport>
      <div class="marquee-track gap-6 px-3" data-marquee-track>
        {track.map((t) => (
          <div class="card card-deep-shadow flex w-[340px] shrink-0 flex-col p-8 sm:w-[380px]">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="#55BFC0">
              <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-4v-10h9.999z"/>
            </svg>
            <div class="mt-4 flex gap-1 text-[#55BFC0]">
              {Array.from({ length: t.data.rating }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="mt-5 flex-1 text-[var(--color-neutral-700)]">"{t.data.text}"</p>
            <div class="mt-6 flex items-center gap-3 pt-5 border-t border-[var(--color-neutral-100)]">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-ink-950)] text-xs font-semibold text-white">
                {initials(t.data.name)}
              </div>
              <div>
                <p class="text-sm font-semibold text-[var(--color-ink-950)]">{t.data.name}</p>
                <p class="text-xs text-[var(--color-neutral-500)]">{t.data.outcome ?? t.data.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
