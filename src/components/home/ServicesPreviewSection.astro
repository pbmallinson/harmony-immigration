---
const categories = [
  {
    label: 'Individuals',
    tagline: 'Your next chapter',
    desc: "When there's document to prepare and details<br />to get right, we’ll help you from start to finish.",
    photo: '/images/individuals.jpg',
  },
  {
    label: 'Families',
    tagline: 'Together for good',
    desc: 'When you have a plan and a lot of questions. We’ll help make sense of the immigration part.',
    photo: '/images/families.jpg',
  },
  {
    label: 'Businesses',
    tagline: 'Grow without borders',
    desc: 'Supporting businesses to hire foreign talents through accreditation and sponsorship.',
    photo: '/images/businesses.jpg',
  },
];
---

<section class="py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-2xl mx-auto text-center">
      <h2>How We Can Help</h2>
      <p class="mt-5 text-lg">From a single work permit to a full family relocation,<br />we cover the pathways that matter most.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-3">
      {categories.map((c, i) => (
        <a
          href="/services"
          class="card reveal group relative aspect-[3/4] w-full overflow-hidden p-0"
          style={`transition-delay:${i * 80}ms`}
        >
          <img
            src={c.photo}
            alt={c.label}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/0"></div>

          <div class="absolute inset-x-0 bottom-0 flex flex-col items-start gap-3 p-8">
            <div
              class="inline-flex w-fit items-center rounded-xl border border-white/40 px-4 py-2 shadow-sm"
              style="background: rgba(255,255,255,0.18); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"
            >
              <span class="font-display text-sm font-semibold tracking-wide text-white">{c.label}</span>
            </div>

            <h3 class="text-white">{c.tagline}</h3>
            <p class="text-sm text-white/80" set:html={c.desc} />
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn btn-dark">View All Services</a>
    </div>
  </div>
</section>
