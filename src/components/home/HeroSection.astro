---
const stats = [
  { value: '4,200+', label: 'Applications filed' },
  { value: '97%', label: 'Approval rate' },
  { value: '18', label: 'Years of practice' },
];
---

<section class="relative overflow-hidden pt-16 pb-24 md:pt-24 md:pb-32">
  <div class="mesh-bg">
    <div class="mesh-blob" style="width:520px;height:520px;background:var(--color-ink-500);top:-220px;right:-160px;"></div>
    <div class="mesh-blob" style="width:420px;height:420px;background:var(--color-flame-500);bottom:-200px;left:-140px;opacity:0.3;"></div>
  </div>

  <div class="container relative z-10">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div class="reveal">
        <span class="eyebrow">Licensed Immigration Advisers</span>
        <h1 class="mt-5">
          Your path abroad,<br />
          <span class="gradient-text">guided with clarity.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg">
          Meridian Immigration helps individuals, families, and employers navigate visas, residence, and citizenship — with honest advice and a plan built around your goals.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/contact" class="btn btn-primary">Book a Free Consultation</a>
          <a href="/services" class="btn btn-outline">Explore Services</a>
        </div>

        <div class="mt-14 grid grid-cols-3 gap-6 max-w-md">
          {stats.map((s) => (
            <div>
              <p class="font-display text-2xl font-semibold text-[var(--color-ink-950)] md:text-3xl">{s.value}</p>
              <p class="mt-1 text-xs text-[var(--color-neutral-600)]">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal relative" style="transition-delay: 120ms;">
        <div class="relative rounded-[2rem] bg-white p-3 shadow-[var(--shadow-glow)]">
          <div class="aspect-[4/5] w-full overflow-hidden rounded-[1.5rem] bg-gradient-to-br from-[var(--color-ink-800)] via-[var(--color-ink-600)] to-[var(--color-flame-600)] relative">
            <div class="absolute inset-0 grain"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
              <p class="font-display text-2xl leading-snug">"They made a confusing process feel completely manageable."</p>
              <p class="mt-4 text-sm text-white/70">Amara O. — Work Visa client</p>
            </div>
          </div>
        </div>

        <div class="absolute -left-6 -bottom-6 hidden md:block rounded-2xl bg-white p-5 shadow-[var(--shadow-md)] border border-[var(--color-neutral-100)]">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-ink-950)] text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-ink-950)]">Case approved</p>
              <p class="text-xs text-[var(--color-neutral-500)]">Residence Visa · 6 weeks</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
