---
const supports = [
  {
    icon: '/images/icons-more-than-visa/job-ready.svg',
    title: 'Job ready',
    desc: 'CVs, employer connection<br class="hidden lg:inline" /> to help you land a role.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong style="font-size:1.4em; -webkit-text-stroke: 0.6px currentColor;">⟶</strong>',
  },
  {
    icon: '/images/icons-more-than-visa/english-prep.svg',
    title: 'English prep',
    desc: 'Exam and interview coaching, so<br class="hidden lg:inline" /> you walk in confident.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong style="font-size:1.4em; -webkit-text-stroke: 0.6px currentColor;">⟶</strong>',
  },
  {
    icon: '/images/icons-more-than-visa/certified-translation.svg',
    title: 'Translation',
    desc: 'Certified translation and interpreting<br class="hidden lg:inline" /> for official and personal needs.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong style="font-size:1.4em; -webkit-text-stroke: 0.6px currentColor;">⟶</strong>',
  },
  {
    icon: '/images/icons-more-than-visa/settling-in.svg',
    title: 'Settling in',
    desc: 'Housing, banking, healthcare<br class="hidden lg:inline" /> and everyday life, sorted.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong style="font-size:1.4em; -webkit-text-stroke: 0.6px currentColor;">⟶</strong>',
  },
];
---

<section class="relative py-24 md:py-32" style="background: #ECF5F5;">
  <div class="container relative">
    <div class="reveal max-w-3xl mx-auto text-center">
      <h2 class="text-[#123B57]">Beyond the visa</h2>
      <p class="mt-5 text-lg text-[#123B57] sm:whitespace-nowrap">Extra help that comes after approval: work, language and everyday life.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {supports.map((s, i) => (
        <div class="reveal card card-deep-shadow px-4 py-6" style={`transition-delay:${i * 80}ms; border: 0.7px solid rgba(148, 191, 205, 0.6);`}>
          <div class="flex h-[52.8px] w-[52.8px] items-center justify-center">
            <img src={s.icon} alt="" class="h-[52.8px] w-[52.8px]" />
          </div>
          <h3 class="mt-5 tracking-tight whitespace-nowrap">{s.title}</h3>
          <p class="mt-2 text-sm" set:html={s.desc} />
        </div>
      ))}
    </div>

    <div class="reveal mt-16 mx-auto flex max-w-4xl flex-col items-start gap-6 rounded-[var(--radius-xl)] bg-[#123B57] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <p class="text-lg font-medium text-white whitespace-nowrap">
        <span class="font-semibold">Not sure where to start?</span> <span class="text-white/80">We'll help you find the right next step.</span>
      </p>
      <a href="/contact" class="btn btn-primary flex-none">Get in Touch</a>
    </div>
  </div>
</section>
