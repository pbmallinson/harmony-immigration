---
import Page from '@layouts/Page.astro';
import { useTranslations, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const visas = await getCollection('visas');
  const langs: Lang[] = ['en', 'hu', 'it', 'de'];

  return langs.flatMap((lang) => {
    const langVisas = visas.filter(
      (v) => v.data.locale === lang || (lang !== 'en' && v.data.locale === 'en')
    );
    return langVisas.map((visa) => ({
      params: { lang, slug: visa.data.slug },
      props: { visa },
    }));
  });
}

const { visa } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const { Content } = await render(visa);

const translations = Object.fromEntries(
  (['en', 'hu', 'it', 'de'] as Lang[]).map((l) => [
    l,
    `${SITE_URL}/${l}/visas/${visa.data.slug}`,
  ])
) as Partial<Record<Lang, string>>;

// Build FAQ schema if the visa has FAQ items
const faqSchema = visa.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: visa.data.faq.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: answer,
        },
      })),
    }
  : undefined;
---

<Page
  title={visa.data.title}
  description={visa.data.shortDesc}
  lang={lang}
  translations={translations}
  canonicalUrl={`${SITE_URL}/${lang}/visas/${visa.data.slug}`}
  schema={faqSchema}
>
  <!-- Header -->
  <div class="bg-earth-800 py-20">
    <div class="container">
      <div class="flex flex-wrap gap-3 mb-4">
        <span class="text-sm px-3 py-1 bg-teal-500/20 text-teal-300 rounded-full font-medium">
          {visa.data.country === 'nz' ? 'New Zealand' : visa.data.country === 'au' ? 'Australia' : 'NZ & Australia'}
        </span>
        {visa.data.isFreeOfCharge && (
          <span class="text-sm px-3 py-1 bg-cream-50/20 text-cream-100 rounded-full font-medium">
            {t('visa.free_badge')}
          </span>
        )}
      </div>
      <h1 class="font-heading text-5xl text-cream-50 mb-4">{visa.data.title}</h1>
      <p class="text-cream-200 text-lg max-w-2xl">{visa.data.shortDesc}</p>
    </div>
  </div>

  <!-- Content -->
  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main content -->
        <div class="lg:col-span-2 prose-content">
          <Content />
        </div>

        <!-- Sidebar -->
        <div>
          <!-- CTA card -->
          <div class="card p-6 mb-6">
            <h3 class="font-heading text-earth-800 text-lg mb-3">{t('visa.enquire')}</h3>
            <p class="text-text-muted text-sm mb-5">Book a free 30-minute consultation to assess your eligibility for this visa.</p>
            <a
              href="https://calendly.com/harmonyimmigration/30min?primary_color=2a9d8f"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full text-center block text-sm"
            >
              {t('nav.book')}
            </a>
            <a
              href={`mailto:harmonyimmigration.nz@gmail.com?subject=Enquiry: ${visa.data.title}`}
              class="btn-secondary w-full text-center block text-sm mt-3"
            >
              Send Enquiry Email
            </a>
          </div>

          <!-- Contact details card -->
          <div class="bg-cream-50 rounded-xl p-6">
            <h3 class="font-semibold text-earth-800 text-sm uppercase tracking-wider mb-4">Contact</h3>
            <div class="space-y-2 text-sm text-text-muted">
              <div><a href="tel:+6421270 4860" class="text-teal-600 hover:underline">+64 21 270 4860</a></div>
              <div><a href="mailto:harmonyimmigration.nz@gmail.com" class="text-teal-600 hover:underline break-all">harmonyimmigration.nz@gmail.com</a></div>
              <div class="pt-1">Mon – Fri, 9am – 5pm NZST</div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ accordion -->
      {visa.data.faq.length > 0 && (
        <div class="mt-16">
          <h2 class="section-heading mb-8">{t('visa.faq.title')}</h2>
          <div class="space-y-3 max-w-3xl">
            {visa.data.faq.map(({ question, answer }) => (
              <details class="bg-white border border-cream-200 rounded-xl group">
                <summary class="flex justify-between items-center p-5 cursor-pointer list-none font-medium text-earth-800 hover:text-teal-600 transition-colors">
                  {question}
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 ml-3 transition-transform group-open:rotate-180" aria-hidden="true">
                    <path d="M4 6l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="px-5 pb-5 text-text-muted leading-relaxed">
                  {answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Page>
