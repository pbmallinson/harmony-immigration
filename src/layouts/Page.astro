---
import Base from './Base.astro';
import Nav from '@components/global/Nav.astro';
import Footer from '@components/global/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
---

<Base {...props}>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</Base>
