---
import { useTranslations, getLocalePath, type Lang } from '@i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang: Lang;
  translations?: Partial<Record<Lang, string>>;
}

const { lang, translations = {} } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear().toString();
---

<footer class="bg-earth-800 text-cream-100 mt-24">
  <div class="container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href={getLocalePath('/', lang)} class="flex items-center gap-2 mb-4">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <circle cx="16" cy="16" r="16" fill="#3dbfb2"/>
            <path d="M8 20 Q16 8 24 20" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M10 22 Q16 12 22 22" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.7"/>
          </svg>
          <span class="font-heading text-lg font-semibold text-cream-50">Harmony Immigration</span>
        </a>
        <p class="text-sm text-cream-300 leading-relaxed mb-4">{t('footer.tagline')}</p>
        <p class="text-xs text-cream-300/70">{t('footer.lia')} · {t('footer.marn')}</p>
        <div class="flex gap-3 mt-5">
          <a href="https://www.linkedin.com/company/harmony-immigration" target="_blank" rel="noopener noreferrer" class="text-cream-300 hover:text-teal-400 transition-colors" aria-label="LinkedIn">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100063787283052" target="_blank" rel="noopener noreferrer" class="text-cream-300 hover:text-teal-400 transition-colors" aria-label="Facebook">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services links -->
      <div>
        <h3 class="text-cream-50 font-semibold text-sm uppercase tracking-wider mb-4">{t('footer.links.services')}</h3>
        <ul class="space-y-2 text-sm text-cream-300">
          <li><a href={getLocalePath('/services/immigration-matters', lang)} class="hover:text-teal-400 transition-colors">Immigration Matters</a></li>
          <li><a href={getLocalePath('/services/employment-accelerator', lang)} class="hover:text-teal-400 transition-colors">Employment Accelerator</a></li>
          <li><a href={getLocalePath('/services/english-visa-prep', lang)} class="hover:text-teal-400 transition-colors">English & Visa Prep</a></li>
          <li><a href={getLocalePath('/services/translate-certify', lang)} class="hover:text-teal-400 transition-colors">Translate & Certify</a></li>
          <li><a href={getLocalePath('/services/settlement-support', lang)} class="hover:text-teal-400 transition-colors">Settlement Support</a></li>
        </ul>
      </div>

      <!-- Visa links -->
      <div>
        <h3 class="text-cream-50 font-semibold text-sm uppercase tracking-wider mb-4">{t('footer.links.visas')}</h3>
        <ul class="space-y-2 text-sm text-cream-300">
          <li><a href={getLocalePath('/visas/work-visa', lang)} class="hover:text-teal-400 transition-colors">Work Visa</a></li>
          <li><a href={getLocalePath('/visas/residence-visa', lang)} class="hover:text-teal-400 transition-colors">Residence Visa</a></li>
          <li><a href={getLocalePath('/visas/partner-family-visa', lang)} class="hover:text-teal-400 transition-colors">Partner & Family Visa</a></li>
          <li><a href={getLocalePath('/visas/student-visa', lang)} class="hover:text-teal-400 transition-colors">Student Visa</a></li>
          <li><a href={getLocalePath('/visas/business-investor-visa', lang)} class="hover:text-teal-400 transition-colors">Business & Investor Visa</a></li>
          <li><a href={getLocalePath('/visas', lang)} class="hover:text-teal-400 transition-colors font-medium text-teal-400/80">All visa types →</a></li>
        </ul>
      </div>

      <!-- Contact + Links -->
      <div>
        <h3 class="text-cream-50 font-semibold text-sm uppercase tracking-wider mb-4">{t('footer.links.contact')}</h3>
        <ul class="space-y-2 text-sm text-cream-300">
          <li><a href={`tel:+6421270 4860`} class="hover:text-teal-400 transition-colors">+64 21 270 4860</a></li>
          <li><a href="mailto:harmonyimmigration.nz@gmail.com" class="hover:text-teal-400 transition-colors break-all">harmonyimmigration.nz@gmail.com</a></li>
          <li class="pt-1">48 Holdens Road, Henderson<br />Auckland 0612, NZ</li>
        </ul>
        <ul class="mt-5 space-y-2 text-sm text-cream-300">
          <li><a href={getLocalePath('/about', lang)} class="hover:text-teal-400 transition-colors">{t('footer.links.about')}</a></li>
          <li><a href={getLocalePath('/blog', lang)} class="hover:text-teal-400 transition-colors">{t('footer.links.blog')}</a></li>
          <li><a href={getLocalePath('/for-employers', lang)} class="hover:text-teal-400 transition-colors">{t('footer.links.employers')}</a></li>
        </ul>
        <div class="mt-5">
          <LanguagePicker lang={lang} translations={translations} />
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-cream-100/10">
    <div class="container py-5 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-cream-300/60">
      <p set:html={t('footer.copyright', { year })} />
      <p>Licensed by the Immigration Advisers Authority, New Zealand</p>
    </div>
  </div>
</footer>
