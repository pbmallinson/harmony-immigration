---
import Icon from '@components/global/Icon.astro';

const principles = [
  {
    icon: 'target',
    title: 'Honest Assessments',
    desc: "If a pathway isn't realistic, we tell you upfront — before you spend time or money on it.",
    size: 'large',
  },
  {
    icon: 'scale',
    title: 'Licensed & Accountable',
    desc: 'Every case is handled by licensed advisers bound by a professional code of conduct.',
  },
  {
    icon: 'clock',
    title: 'Clear Timelines',
    desc: 'You always know what stage your case is at and what happens next.',
  },
  {
    icon: 'globe',
    title: 'Global Experience',
    desc: 'Cases handled across dozens of nationalities and visa categories.',
  },
];
---

<section class="py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">Why Meridian</span>
      <h2 class="mt-5">Guidance you can actually trust.</h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      <div class="reveal card md:col-span-2 md:row-span-2 p-10 flex flex-col justify-between bg-[var(--color-ink-950)] text-white border-none">
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-white">
            <Icon name={principles[0].icon} class="w-6 h-6" />
          </div>
          <h3 class="mt-6 text-white">{principles[0].title}</h3>
          <p class="mt-3 text-white/70 max-w-sm">{principles[0].desc}</p>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-6 max-w-sm">
          <div>
            <p class="font-display text-2xl font-semibold text-white">97%</p>
            <p class="text-xs text-white/50 mt-1">Approval rate</p>
          </div>
          <div>
            <p class="font-display text-2xl font-semibold text-white">4,200+</p>
            <p class="text-xs text-white/50 mt-1">Cases filed</p>
          </div>
        </div>
      </div>

      {principles.slice(1).map((p, i) => (
        <div class="reveal card p-8" style={`transition-delay:${(i + 1) * 80}ms`}>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-cream-200)] text-[var(--color-ink-800)]">
            <Icon name={p.icon} class="w-6 h-6" />
          </div>
          <h3 class="mt-5">{p.title}</h3>
          <p class="mt-2 text-sm">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
