---
const principles = [
  {
    title: 'Honest Assessments',
  },
  {
    icon: '/images/icons-why-choose/local-expertise.svg',
    title: 'Local expertise',
    desc: 'Advice from licensed professionals who understand immigration practical implications.',
  },
  {
    icon: '/images/icons-why-choose/clear-communication.svg',
    title: 'Clear communication',
    desc: 'We will keep you informed with clear<br />advice and straightforward timelines.',
  },
  {
    icon: '/images/icons-why-choose/tailored-plan.svg',
    title: 'Tailored plan',
    desc: 'We look at where you want to go in the future so we build the plan around you, not a template.',
  },
  {
    icon: '/images/icons-why-choose/complex-cases.svg',
    title: 'Complex cases',
    desc: "When the obvious pathway isn't the right one, we look for a better way forward.",
  },
  {
    icon: '/images/icons-why-choose/upfront-costs.svg',
    title: 'Upfront costs',
    desc: 'Clear pricing and a written agreement before you proceed, so you know exactly what to expect.',
  },
];
---

<section class="py-24 md:py-32">
  <div class="container">
    <div class="reveal max-w-5xl mx-auto text-center">
      <h2>Why choose Harmony</h2>
      <p class="mt-5 text-lg lg:whitespace-nowrap">Immigration should open doors so we built this company to make that journey simpler for the people going through it.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      <div class="reveal card md:col-span-2 md:row-span-2 border-none overflow-hidden p-0">
        <img src="/images/why-choose-harmony.png" alt={principles[0].title} class="w-full h-full object-cover" />
      </div>

      {principles.slice(1).map((p, i) => (
        <div class="reveal card card-highlight p-8" style={`transition-delay:${(i + 1) * 80}ms`}>
          <div class="flex h-12 w-12 items-center justify-center">
            <img src={p.icon} alt="" class="w-12 h-12" />
          </div>
          <h3 class="mt-5">{p.title}</h3>
          <p class="mt-2 text-sm" set:html={p.desc} />
        </div>
      ))}
    </div>
  </div>
</section>
