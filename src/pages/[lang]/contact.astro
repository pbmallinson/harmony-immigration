---
import Page from '@layouts/Page.astro';
import { useTranslations, getAlternateUrls, type Lang } from '@i18n/utils';
import { SITE_URL } from '@lib/schema';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translations = getAlternateUrls('/contact');

const fullTranslations = Object.fromEntries(
  Object.entries(translations).map(([l, path]) => [l, `${SITE_URL}${path}`])
) as Partial<Record<Lang, string>>;
---

<Page
  title={t('contact.title')}
  description="Contact Harmony Immigration Ltd. Phone: +64 21 270 4860. Email: harmonyimmigration.nz@gmail.com. Based in Henderson, Auckland."
  lang={lang}
  translations={fullTranslations}
  canonicalUrl={`${SITE_URL}/${lang}/contact`}
>
  <!-- Header -->
  <div class="bg-earth-800 py-20">
    <div class="container text-center">
      <h1 class="font-heading text-5xl text-cream-50 mb-4">{t('contact.title')}</h1>
      <p class="text-cream-200 text-lg max-w-xl mx-auto">{t('contact.subtitle')}</p>
    </div>
  </div>

  <!-- Contact details + booking -->
  <section class="py-20">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Contact details -->
        <div>
          <h2 class="section-heading mb-8">Contact Details</h2>

          <dl class="space-y-6">
            <!-- Address -->
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#2a9d8f" stroke-width="1.8" aria-hidden="true">
                  <path d="M10 2C6.69 2 4 4.69 4 8c0 4.5 6 10 6 10s6-5.5 6-10c0-3.31-2.69-6-6-6z" stroke-linecap="round"/>
                  <circle cx="10" cy="8" r="2"/>
                </svg>
              </div>
              <div>
                <dt class="font-semibold text-earth-800 mb-1">{t('contact.address')}</dt>
                <dd class="text-text-muted">
                  <a
                    href="https://maps.google.com/?q=48+Holdens+Road+Henderson+Auckland"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-teal-600 transition-colors"
                  >
                    48 Holdens Road, Henderson<br />Auckland 0612, New Zealand
                  </a>
                </dd>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#2a9d8f" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 3h4l2 5-2.5 1.5a11 11 0 005 5L14 12l5 2v4a2 2 0 01-2 2C8 20 0 12 0 3a2 2 0 012-2h2z"/>
                </svg>
              </div>
              <div>
                <dt class="font-semibold text-earth-800 mb-1">{t('contact.phone')}</dt>
                <dd>
                  <a href="tel:+6421270 4860" class="text-teal-600 hover:text-teal-700 transition-colors font-medium">
                    +64 21 270 4860
                  </a>
                </dd>
              </div>
            </div>

            <!-- Email -->
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#2a9d8f" stroke-width="1.8" aria-hidden="true">
                  <path d="M2 4h16v12H2V4z" stroke-linejoin="round"/>
                  <path d="M2 4l8 7 8-7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div>
                <dt class="font-semibold text-earth-800 mb-1">{t('contact.email')}</dt>
                <dd>
                  <a href="mailto:harmonyimmigration.nz@gmail.com" class="text-teal-600 hover:text-teal-700 transition-colors font-medium break-all">
                    harmonyimmigration.nz@gmail.com
                  </a>
                </dd>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-teal-500/10 rounded-lg flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#2a9d8f" stroke-width="1.8" aria-hidden="true">
                  <circle cx="10" cy="10" r="8"/>
                  <path d="M10 5v5l3 3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div>
                <dt class="font-semibold text-earth-800 mb-1">{t('contact.hours')}</dt>
                <dd class="text-text-muted">
                  <span class="block">{t('contact.hours.weekdays')}</span>
                  <span class="font-medium text-earth-800">{t('contact.hours.time')}</span>
                </dd>
              </div>
            </div>
          </dl>

          <!-- Social links -->
          <div class="mt-10">
            <h3 class="font-semibold text-earth-800 mb-4 text-sm uppercase tracking-wider">{t('contact.social')}</h3>
            <div class="flex gap-4">
              <a
                href="https://www.linkedin.com/company/harmony-immigration"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-4 py-2.5 bg-cream-100 hover:bg-teal-500/10 text-earth-600 hover:text-teal-700 rounded-lg transition-colors text-sm font-medium"
              >
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
              <a
                href="https://www.facebook.com/profile.php?id=100063787283052"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 px-4 py-2.5 bg-cream-100 hover:bg-teal-500/10 text-earth-600 hover:text-teal-700 rounded-lg transition-colors text-sm font-medium"
              >
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
              </a>
            </div>
          </div>
        </div>

        <!-- Calendly booking -->
        <div class="bg-cream-50 rounded-2xl p-8">
          <h2 class="section-heading mb-2">{t('contact.book.title')}</h2>
          <p class="text-text-muted mb-8 leading-relaxed">{t('contact.book.desc')}</p>

          <!-- Calendly inline embed -->
          <div
            class="calendly-inline-widget rounded-xl overflow-hidden border border-cream-200"
            data-url="https://calendly.com/harmonyimmigration/30min?hide_gdpr_banner=1&primary_color=2a9d8f"
            style="min-width:280px;height:680px;"
          ></div>

          <!-- Fallback link for no-JS -->
          <noscript>
            <a
              href="https://calendly.com/harmonyimmigration/30min"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full text-center mt-4 block"
            >
              {t('contact.book.btn')}
            </a>
          </noscript>
        </div>
      </div>
    </div>
  </section>
</Page>

<script async src="https://assets.calendly.com/assets/external/widget.js"></script>
