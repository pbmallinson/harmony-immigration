---
import Page from '@layouts/Page.astro';

const linkLabels: Record<string, string> = {
  hiring: 'Hiring',
  entrepreneurs: 'Entrepreneurs',
  'employer-support': 'Maintain',
  accreditation: 'Accreditation',
  individuals: 'Individuals',
  families: 'Families',
};
const linkHrefs: Record<string, string> = {
  hiring: '/businesses/hiring',
  entrepreneurs: '/businesses/entrepreneurs',
  'employer-support': '/businesses/employer-support',
  accreditation: '/businesses/accreditation',
  individuals: '/services',
  families: '/families',
};

const businessPagesData: Record<string, {
  heroTitle: string;
  heroDesc: string;
  bannerImage?: string;
  bannerPosition?: string;
  cards: { title: string; visas: { country: string; name: string; desc: string }[] }[];
  noneOfTheseBold: string;
  noneOfTheseSecondLine?: string;
  checklist: string[];
  faq: { question: string; answer: string }[];
  linkRowOrder: string[];
  bottomStripHeading: string;
  bottomStripText?: string;
}> = {
  accreditation: {
    heroTitle: 'Get approved',
    bannerImage: '/images/accreditation-banner-v2.png',
    heroDesc: "Business approval comes before any worker sponsorship.",
    cards: [
      {
        title: 'We want to hire a handful of workers',
        visas: [
          { country: 'NZ', name: 'Standard accreditation', desc: 'For up to 5 AEWV workers at a time.' },
          { country: 'AU', name: 'Standard Business Sponsorship', desc: 'The base approval every sponsoring employer needs.' },
        ],
      },
      {
        title: 'We hire overseas staff regularly',
        visas: [
          { country: 'NZ', name: 'High-volume accreditation', desc: 'For 6 or more AEWV workers at a time.' },
          { country: 'AU', name: 'Accredited Sponsor status', desc: 'For businesses with a strong compliance record,\nfaster processing on future nominations.' },
        ],
      },
      {
        title: "We're labour-hire or staffing agency",
        visas: [
          { country: 'NZ', name: 'Triangular employment accreditation', desc: 'For labour hire and similar arrangements.' },
        ],
      },
    ],
    noneOfTheseBold: 'Want to hire or your business scaling up fast?',
    noneOfTheseSecondLine: "Talk to us and we'll tell you which approval fits you.",
    checklist: [
      'The right sponsorship status, matched to your business.',
      'Preparing your application and the evidence it needs.',
      'Handling communication with immigration authorities on your behalf.',
      "Making sure you understand what you're signing up to, accreditation comes with ongoing obligations, not just a one-off approval.",
    ],
    faq: [
      {
        question: 'How long does accreditation or sponsorship last?',
        answer: "In New Zealand, initial accreditation runs 12 months, with renewals typically valid for 24. In Australia, Standard Business Sponsorship is valid for 5 years. We'll walk you through what renewal looks like for your business.",
      },
      {
        question: 'What happens if we lose accreditation or sponsorship?',
        answer: "Both countries can suspend or revoke it for breaches of the conditions attached, which also puts any workers you've sponsored at risk. We'll make sure you understand your ongoing obligations before you commit, not after something goes wrong.",
      },
      {
        question: "Do we need accreditation to keep employing someone we've already sponsored?",
        answer: "Not always, in New Zealand, accreditation is only required to support new AEWV applications, not to continue employing someone already on one. We'll confirm what applies to your situation.",
      },
      {
        question: 'How much does accreditation or sponsorship cost, and how long does approval take?',
        answer: "It depends on the type and country, New Zealand's accreditation fees and processing times vary by category, and Australia's sponsorship fee and timeline differ again. We'll give you exact figures for your situation rather than a general estimate that might already be out of date.",
      },
    ],
    linkRowOrder: ['hiring', 'entrepreneurs', 'employer-support', 'individuals', 'families'],
    bottomStripHeading: 'Looking for hiring, investing or ongoing support instead?',
  },
  hiring: {
    heroTitle: 'Hire overseas talents',
    bannerImage: '/images/hiring-banner-v2.png',
    heroDesc: 'Once your business is approved, this\nis where you actually sponsor someone.',
    cards: [
      {
        title: 'We need a skilled worker for an ongoing job',
        visas: [
          { country: 'NZ', name: 'Accredited Employer Work Visa', desc: 'Through a Job Check for the specific role.' },
          { country: 'AU', name: 'Skills in Demand visa (482)', desc: 'For workers sponsored by an Australian employer.' },
        ],
      },
      {
        title: 'We want to sponsor someone\nfor permanent residence',
        visas: [
          { country: 'NZ', name: 'Work to Residence Visa', desc: 'For Tier 2 Green List roles or jobs\npaid at least twice the median wage.' },
          { country: 'AU', name: 'Employer Nomination Scheme (186)', desc: 'Permanent residence through your employer.' },
        ],
      },
      {
        title: "We're hiring for a regional location",
        visas: [
          { country: 'AU', name: 'Skilled Employer Sponsored Regional visa (494)', desc: 'A provisional visa for regionally based employer-sponsored roles for permanent residence.' },
        ],
      },
      {
        title: 'We need seasonal workers for horticulture or viticulture',
        visas: [
          { country: 'NZ', name: 'Recognised Seasonal Employer (RSE) scheme', desc: 'Horticulture employers recruiting seasonal workers.' },
          { country: 'AU', name: 'Pacific Australia Labour Mobility (PALM) scheme', desc: 'Horticulture employers recruiting seasonal workers for short and longer-term stream.' },
        ],
      },
    ],
    noneOfTheseBold: 'Hiring temporary, permanent, regionally or seasonal?',
    noneOfTheseSecondLine: "Tell us the role you have in mind, and we'll figure out how you get there.",
    checklist: [
      'Matching the right visa to the role and location.',
      'Handling all communication with immigration.',
      "Updating you if rules or the worker's situation change.",
      "Preparing the nomination or Job Check and the worker's application.",
    ],
    faq: [
      {
        question: 'Does the worker need a job offer before we start?',
        answer: "Yes, a confirmed, genuine job offer is the starting point for every route on this page, it's what the whole sponsorship is built around.",
      },
      {
        question: 'How long does sponsorship take from job offer to visa?',
        answer: "It depends on the visa and the country, and processing times shift often. We'll give you a realistic estimate once we know the specific role and route.",
      },
      {
        question: 'Can this lead to permanent residence for the worker?',
        answer: "Sometimes, directly through Australia's Employer Nomination Scheme, or over time through New Zealand's Green List pathways. We'll map out whether that's realistic for your situation, not just assume it.",
      },
      {
        question: "What happens if the worker's role or location changes after they arrive?",
        answer: "Most of these visas are tied to the specific job and employer approved in the nomination, so a real change usually needs a new Job Check or nomination, not just an internal transfer. We'll flag this early so it doesn't catch you out.",
      },
    ],
    linkRowOrder: ['accreditation', 'entrepreneurs', 'employer-support', 'individuals', 'families'],
    bottomStripHeading: 'Looking for Accreditation, Entrepreneurs, or Ongoing support instead?',
  },
  'employer-support': {
    heroTitle: 'Keep businesses compliant',
    bannerImage: '/images/employer-support-banner.png',
    heroDesc: 'We help you manage your ongoing accreditation obligations.',
    cards: [
      {
        title: 'Our accreditation or sponsorship\nis due for renewal',
        visas: [
          { country: 'NZ', name: 'Accreditation renewal', desc: 'Granted for 1 year, renewed for 2 when you meet existing obligations.' },
          { country: 'AU', name: 'Standard Business Sponsorship renewal', desc: 'Valid 5 years, renewed on the same compliance history.' },
        ],
      },
      {
        title: 'Our employee or the business\nhas changed',
        visas: [
          { country: 'NZ', name: 'Notify INZ if a sponsored worker stops working for you, or if your business changes in a relevant way.', desc: '' },
          { country: 'AU', name: "Tell the Department in writing within 28 days of defined changes, to the worker's role or to your business.", desc: '' },
        ],
      },
      {
        title: "We've been selected for\na compliance audit",
        visas: [
          { country: 'NZ', name: 'Immigration checks that accredited employers meet their obligations.', desc: '' },
          { country: 'AU', name: 'The Department and Fair Work Inspectors conduct audits on records, pay and reported changes.', desc: '' },
        ],
      },
      {
        title: 'We need to understand our\nongoing obligations',
        visas: [
          { country: 'AU', name: 'The Skilling Australians Fund (SAF) levy', desc: 'Mandatory training contribution paid\nwhen nominating a worker.' },
        ],
      },
    ],
    noneOfTheseBold: 'Concerned about staying compliant?',
    noneOfTheseSecondLine: 'We can review your setup and shore up any weak spots.',
    checklist: [
      "Reviewing your obligations against what’s been done.",
      'Preparing renewal applications with audit‑ready evidence.',
      'Managing the notifications and reporting your business is required to make.',
      'Standing with you through a compliance check or audit, not just before one.',
    ],
    faq: [
      {
        question: 'What happens if our accreditation or sponsorship lapses?',
        answer: "In New Zealand, workers you already sponsor can keep working until their visa expires, but you can't sponsor anyone new until you're reaccredited. In Australia, a lapsed sponsorship similarly blocks new nominations. We'll help you renew with enough time to avoid the gap.",
      },
      {
        question: "What if we're found non-compliant?",
        answer: "It depends on the severity, from a formal letter of concern through to loss of accredited status. Acting early, before a check happens, is far better than responding after one. We'll help you get ahead of it.",
      },
      {
        question: "Do we need to notify authorities if a worker's role changes, even a promotion?",
        answer: "Often, yes. A real change to duties or structure can need a fresh notification, or even a new nomination, in both countries. We'll flag this before it becomes a compliance issue, not after.",
      },
      {
        question: 'How much is the SAF levy, and can we pass the cost to the employee?',
        answer: "The levy is a fixed, mandatory cost to the business, and employers are not allowed to recover it from the sponsored worker, directly or indirectly. We'll confirm the current rate for your business size.",
      },
    ],
    linkRowOrder: ['accreditation', 'hiring', 'entrepreneurs', 'individuals', 'families'],
    bottomStripHeading: 'Looking for Accreditation, Hiring, or Entrepreneurs instead?',
  },
  entrepreneurs: {
    heroTitle: 'Investor visas',
    bannerImage: '/images/partner-visas-banner-v2.png',
    bannerPosition: '-7px',
    heroDesc: 'Invest capital to buy and run businesses to secure residency.',
    cards: [
      {
        title: 'I want to make a high-value investment',
        visas: [
          { country: 'NZ', name: 'Active Investor Plus visa', desc: 'Growth category (NZ$5 million, 3 years) or Balanced category (NZ$10 million, 5 years).' },
        ],
      },
      {
        title: 'I want to buy into or run an existing business',
        visas: [
          { country: 'NZ', name: 'Business Investor Work Visa', desc: 'NZ$1 million for a 3-year work-to-residence pathway, or NZ$2 million for a fast-tracked route after 12 months.' },
        ],
      },
      {
        title: 'I want to start a new business from scratch',
        visas: [
          { country: 'NZ', name: 'Entrepreneur Work Visa', desc: 'Leads to the Entrepreneur Resident Visa once established.' },
        ],
      },
      {
        title: 'I have an internationally recognised record in a nationally important field',
        visas: [
          { country: 'AU', name: 'National Innovation Visa (858)', desc: 'For exceptional talent driving growth in priority sectors. Invitation-only, not investment-based.' },
        ],
      },
    ],
    noneOfTheseBold: 'Thinking of investing?',
    noneOfTheseSecondLine: "Tell us your plans and we'll be honest about which door is really open.",
    checklist: [
      "Giving you an honest, current picture of what's actually open, not just what used to be.",
      'Matching your investment or business plan to the category that actually fits.',
      'Preparing the application and the evidence it needs, including proof of funds and business plans.',
      'Staying with you through what are often multi-year investment periods, not just the application itself.',
    ],
    faq: [
      {
        question: "Is Australia's investor visa really closed?",
        answer: "Yes, the Business Innovation and Investment visa (188) closed to new applicants in July 2024. Its replacement, the National Innovation Visa, isn't an investment visa, it's invitation-only, for exceptional achievement, with no dollar threshold.",
      },
      {
        question: 'Do I have to live in New Zealand to keep my Active Investor Plus visa?',
        answer: 'Yes, there\'s a minimum time requirement during the investment period, currently as little as 21 days over 3 years for the Growth category, though this has changed before and can change again.',
      },
      {
        question: 'What counts as "an existing business" for the Business Investor Work Visa?',
        answer: "It must have been operating for at least 5 years already, this isn't a visa for buying a shell company or starting fresh, that's what the Entrepreneur visa is for.",
      },
      {
        question: "If Australia's door is closed, is there any other way in through business?",
        answer: "Often, yes, through the skilled migration program if your occupation qualifies, or an employer-sponsored route if you're also prepared to work for a sponsoring business. It's a different path than investing directly, and we can talk through whether it fits.",
      },
    ],
    linkRowOrder: ['accreditation', 'hiring', 'employer-support', 'individuals', 'families'],
    bottomStripHeading: 'Looking for Accreditation, Hiring, or Ongoing support instead?',
  },
};

export async function getStaticPaths() {
  return ['accreditation', 'hiring', 'employer-support', 'entrepreneurs'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const data = businessPagesData[slug as string];
---

<Page
  title={data.heroTitle}
  description={data.heroDesc}
>
  <section class="relative overflow-hidden min-h-[333px] pb-16 pt-[94px] md:pt-[126px]" style="background: white;">
    <div class="absolute inset-0 bg-cover" style={`background-image: url('${data.bannerImage ?? '/images/work-visas-banner.png'}'); background-position: center ${data.bannerPosition ?? 'bottom'};`}></div>
    <div class="container relative z-10 reveal pl-[53px] -mt-[50px]">
      <a href="/businesses" class="inline-flex items-center gap-1.5 text-sm font-semibold mb-6" style="color:#55BFC0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to Businesses
      </a>
      <h1 class="mt-6 text-4xl sm:text-5xl">
        {data.heroTitle.split('\n').map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      <p class="mt-5 text-lg">
        {data.heroDesc.split('\n').map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="pb-20 pt-px" style="background: white;">
    <div class="container">
      <div class="relative z-10 mt-[47px] grid gap-6 sm:grid-cols-2">
        {data.cards.map((card, i) => (
          <div class="card card-deep-shadow reveal flex flex-col p-7" style={`transition-delay:${i * 70}ms; border: 0.7px solid rgba(18, 59, 87, 0.4);`}>
            <h3 class="w-[calc(100%-65px)] border-b border-[rgba(18,59,87,0.2)] pb-4">
              {card.title.split('\n').map((line, li) => (
                <>{li > 0 && <br />}{line}</>
              ))}
            </h3>
            <div class="flex-1">
              {card.visas.map((visa, vi) => (
                <div class={`flex w-[calc(100%-65px)] items-start gap-3 py-4 ${vi > 0 ? 'border-t border-[rgba(18,59,87,0.2)]' : ''}`}>
                  <img
                    src={visa.country === 'NZ' ? '/images/icons-about/nz-navy.svg' : '/images/icons-about/australia-navy.svg'}
                    alt={visa.country === 'NZ' ? 'New Zealand' : 'Australia'}
                    class="h-12 w-12 shrink-0"
                  />
                  <div>
                    <p class="font-semibold text-[var(--color-ink-950)]">{visa.name}</p>
                    <p class="mt-0.5">
                      {visa.desc.split('\n').map((line, li) => (
                        <>
                          {li > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </p>
                  </div>
                </div>
              ))}
            </div>
            <button type="button" class="btn btn-lift mt-6 self-start" style="background:#55BFC0; border-color:#55BFC0; color:white;">Check eligibility</button>
          </div>
        ))}
      </div>

      <div class="reveal mx-auto mt-[80px] flex max-w-[972px] flex-col items-start gap-6 rounded-[var(--radius-xl)] bg-[#123B57] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <div>
          <p class="text-lg whitespace-nowrap text-white">
            <span class="font-semibold">{data.noneOfTheseBold}</span>
          </p>
          {data.noneOfTheseSecondLine && (
            <p class="mt-2 text-lg whitespace-nowrap text-white/80">{data.noneOfTheseSecondLine}</p>
          )}
        </div>
        <a href="/contact" class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">Send a message</a>
      </div>
    </div>
  </section>

  <section class="bg-white pt-28 pb-20">
    <div class="container">
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-40">
        <div class="reveal">
          <h2>What we do</h2>
          <ul class="mt-6 space-y-4">
            {data.checklist.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-4 w-4 shrink-0 text-[var(--color-flame-500)]" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="text-[#123B57]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="reveal">
          <h2>Common questions</h2>
          <div class="mt-6 space-y-4">
            {data.faq.map((item) => (
              <details class="faq-details">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[#123B57]">
                  {item.question}
                  <span class="faq-icon shrink-0 text-2xl leading-none text-[#123B57]">+</span>
                </summary>
                <p class="mt-2 italic text-[#123B57]">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pt-16 pb-0 -mb-[4px] bg-white md:mb-0 md:pb-[28px]">
    <div class="reveal w-full overflow-hidden bg-cover bg-right py-10" style="background-image: url('/images/coastal-path.png');">
      <div class="container flex flex-col gap-6">
        <div>
          <p class="text-lg font-semibold text-[#123B57]">{data.bottomStripHeading}</p>
          {data.bottomStripText && (
            <p class="mt-2 text-[#123B57]">{data.bottomStripText}</p>
          )}
        </div>
        <div class="flex flex-wrap gap-3">
          {data.linkRowOrder.map((key) => (
            <a href={linkHrefs[key]} class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">{linkLabels[key] ?? key}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .faq-details summary {
    list-style: none;
  }
  .faq-details summary::-webkit-details-marker {
    display: none;
  }
  .faq-details .faq-icon {
    transition: transform 0.2s ease;
  }
  .faq-details[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>
