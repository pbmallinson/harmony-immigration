<section class="relative overflow-hidden py-24 md:py-32 bg-[var(--color-ink-950)]">
  <div class="mesh-bg">
    <div class="mesh-blob" style="width:480px;height:480px;background:var(--color-ink-500);top:-200px;left:10%;"></div>
    <div class="mesh-blob" style="width:420px;height:420px;background:var(--color-flame-600);bottom:-220px;right:5%;opacity:0.35;"></div>
  </div>

  <div class="container relative z-10 reveal text-center">
    <span class="eyebrow justify-center">Ready When You Are</span>
    <h2 class="mt-5 text-white max-w-2xl mx-auto">Let's find the right pathway for your future.</h2>
    <p class="mt-5 text-white/70 max-w-lg mx-auto text-lg">
      Book a free 20-minute consultation and leave with a clear picture of your options.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-primary">Book a Consultation</a>
      <a href="/services" class="btn btn-outline-light">Browse Services</a>
    </div>
  </div>
</section>
