import ServicesPreviewSection from '@components/home/ServicesPreviewSection.astro';
import ProcessSection from '@components/home/ProcessSection.astro';
import CorePrinciplesSection from '@components/home/CorePrinciplesSection.astro';
import SupportServicesSection from '@components/home/SupportServicesSection.astro';
import TeamSection from '@components/home/TeamSection.astro';
