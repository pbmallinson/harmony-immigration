---
import Page from '@layouts/Page.astro';

const cards = [
  {
    icon: '/images/icons-more-than-visa/job-ready.svg',
    photo: '/images/businesses.jpg',
    photoPosition: 'object-[center_32%]',
    title: 'Job ready',
    desc: 'Finding work in a new country is its own challenge, separate from the visa itself.',
    checklist: ['CVs & cover letters', 'Employer connections', 'Interview preparation'],
  },
  {
    icon: '/images/icons-more-than-visa/english-prep.svg',
    photo: '/images/hero-conversation.jpg',
    photoPosition: 'object-top',
    title: 'English prep',
    desc: "Visa interviews and language requirements don't leave much room to guess.",
    checklist: ['IELTS & exam prep', 'Couples interview training'],
  },
  {
    icon: '/images/icons-more-than-visa/certified-translation.svg',
    photo: '/images/individuals.jpg',
    photoPosition: 'object-[center_30%]',
    title: 'Translation',
    desc: 'NAATI and NZSTI accredited, so documents meet requirements the first time.',
    checklist: ['Translating', 'Interpreting', 'Document certification'],
  },
  {
    icon: '/images/icons-more-than-visa/settling-in.svg',
    photo: '/images/families.jpg',
    photoPosition: 'object-[center_28%]',
    title: 'Settling in',
    desc: 'Getting the visa is one milestone. Building an actual life here is the next.',
    checklist: ['Accommodation', 'Tenant rights', 'GP registration', 'Tax (IRD) enrolment', 'Opening a bank account', 'Transportation'],
  },
];

const faq = [
  {
    question: 'Do I need to be a client for immigration advice to use these?',
    answer: 'No, these stand on their own, with or without us handling your visa.',
  },
  {
    question: 'Can I use more than one of these at once?',
    answer: 'Yes, most people end up needing two or three together.',
  },
  {
    question: 'Do these cost extra on top of visa advice?',
    answer: "Yes, we'll always be upfront about cost before you commit to anything.",
  },
];

const pathwayLinks = [
  { label: 'Individuals', href: '/services' },
  { label: 'Families', href: '/families' },
  { label: 'Businesses', href: '/businesses' },
];
---

<Page
  title="Settling in takes more than a visa"
  description="Job readiness, English preparation, certified translation and settling-in support for after your visa is approved."
>
  <section class="relative overflow-hidden pb-16 pt-[94px] md:pt-[126px]" style="background: white;">
    <div class="absolute inset-0 bg-cover" style="background-image: url('/images/why-choose-harmony.png'); background-position: center 35%;"></div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(255,255,255,0.97) 0%, rgba(255,255,255,0.9) 35%, rgba(255,255,255,0.35) 65%, rgba(255,255,255,0) 100%);"></div>
    <div class="container relative z-10 reveal pl-[53px] -mt-[50px]">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold mb-6" style="color:#55BFC0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
      </a>
      <h1 class="mt-6 text-4xl sm:text-5xl">Settling in takes<br />more than a visa</h1>
      <p class="mt-5 max-w-lg text-lg">A visa gets you here. These four things help with everything that comes after.</p>
    </div>
  </section>

  <section class="pb-20 pt-px" style="background: white;">
    <div class="container">
      <div class="relative z-10 mt-[47px] grid gap-6 sm:grid-cols-2">
        {cards.map((card, i) => (
          <div class="card card-deep-shadow reveal overflow-hidden" style={`transition-delay:${i * 70}ms; border: 0.7px solid rgba(18, 59, 87, 0.4);`}>
            <div class="relative h-[180px] w-full overflow-hidden">
              <img src={card.photo} alt="" class={`h-full w-full object-cover ${card.photoPosition}`} />
              <div class="absolute bottom-[-26px] left-7 flex h-[52px] w-[52px] items-center justify-center rounded-full bg-white shadow-md" style="border: 0.7px solid rgba(18,59,87,0.15);">
                <img src={card.icon} alt="" class="h-7 w-7" />
              </div>
            </div>
            <div class="p-7 pt-9">
              <h3 class="tracking-tight">{card.title}</h3>
              <p class="mt-2 text-[#123B57]">{card.desc}</p>
              <ul class={`mt-4 grid gap-x-6 gap-y-1 text-sm text-[#123B57] ${card.checklist.length > 3 ? 'sm:grid-cols-2' : ''}`}>
                {card.checklist.map((item) => (
                  <li class="flex items-start gap-2">
                    <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-[var(--color-flame-500)]" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a href="/contact" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold" style="color:#55BFC0;">
                Want help with this? <span class="underline">Send a message</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="reveal relative mx-auto mt-[80px] flex max-w-[972px] flex-col items-start gap-6 overflow-hidden rounded-[var(--radius-xl)] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10" style="background: #ECF5F5;">
        <div class="flex items-start gap-5 sm:items-center">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full" style="background: #C9E1EA;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" style="color:#123B57;"><path d="M4 9h16M4 15h16M9 4v16M15 4v16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <div>
            <p class="text-lg font-semibold text-[#123B57]">Not sure which of these you actually need?</p>
            <p class="mt-2 text-[#123B57]">Most people need more than one. Tell us where you're at, and we'll help you work out what matters most right now.</p>
          </div>
        </div>
        <a href="/contact" class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">Send a message</a>
      </div>
    </div>
  </section>

  <section class="bg-white pt-28 pb-20">
    <div class="container">
      <h2>Common questions</h2>
      <div class="mt-8 space-y-4">
        {faq.map((item) => (
          <details class="faq-box rounded-[var(--radius-lg)] p-5" style="border: 0.7px solid rgba(18, 59, 87, 0.2);">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[#123B57]">
              {item.question}
              <svg class="faq-chevron h-4 w-4 shrink-0 text-[#123B57]" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="mt-3 text-[#123B57]">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="pt-16 pb-0 -mb-[4px] bg-white md:mb-0 md:pb-[28px]">
    <div class="reveal w-full overflow-hidden bg-cover bg-right py-10" style="background-image: url('/images/coastal-path.png');">
      <div class="container flex flex-col gap-6">
        <div>
          <p class="text-lg font-semibold text-[#123B57]">Looking for a visa pathway instead?</p>
          <p class="mt-2 text-[#123B57]">Explore options for individuals, families or businesses.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {pathwayLinks.map((link) => (
            <a href={link.href} class="btn flex-none inline-flex items-center gap-2" style="background:#55BFC0; border-color:#55BFC0; color:white;">
              {link.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .faq-box summary {
    list-style: none;
  }
  .faq-box summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    transition: transform 0.2s ease;
  }
  .faq-box[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
