---
const steps = [
  {
    number: '01',
    title: 'Free consultation',
    desc: 'Tell us about your circumstances,<br />plans, goals and your concerns.',
  },
  {
    number: '02',
    title: 'Review your options',
    desc: 'We assess your situation and identify<br />pathways realistically open to you.',
  },
  {
    number: '03',
    title: 'Create a plan for you',
    desc: 'You receive a tailored plan with visa<br />route, documents, timeline, and cost.',
  },
  {
    number: '04',
    title: 'Prepare application',
    desc: 'We help you organise your documents<br />and check against the requirements.',
  },
  {
    number: '05',
    title: 'Lodge and communicate',
    desc: 'We submit your application handle all<br />communication with the authorities.',
  },
  {
    number: '06',
    title: 'Support beyond visas',
    desc: 'Once approved, we help you settle<br />and move forward with your new life.',
  },
];
---

<section class="py-24 md:py-32 bg-[var(--color-cream-100)]">
  <div class="container">
    <div class="reveal max-w-3xl mx-auto text-center">
      <h2>How we work with you</h2>
      <p class="mt-5 text-lg sm:whitespace-nowrap">From the first conversation onward, you'll always know what's happening and what comes next.</p>
    </div>

    <div class="mt-16 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((step, i) => (
        <div class="reveal card card-deep-shadow relative p-8" style={`transition-delay:${i * 90}ms`}>
          <span class="font-display text-5xl font-semibold" style="color: var(--color-cream-100);">
            {step.number}
          </span>
          <h3 class="mt-4">{step.title}</h3>
          <p class="mt-3 text-sm" set:html={step.desc} />
        </div>
      ))}
    </div>
  </div>
</section>
