---
import { getCollection } from 'astro:content';
import { initials } from '@lib/initials';

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;

const all = await getCollection('testimonials');
// getCollection doesn't preserve the JSON file's array order, so sort explicitly:
// shortest review first, longest last.
const testimonials = all.sort((a, b) => a.data.text.length - b.data.text.length).slice(0, 6);
---

<section class="py-24 md:py-32">
  <div class="container">
    {showHeading && (
      <div class="reveal max-w-2xl">
        <span class="eyebrow">Client Stories</span>
        <h2 class="mt-5">Real outcomes, in their own words.</h2>
      </div>
    )}

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t, i) => (
        <div class="reveal card p-8 flex flex-col" style={`transition-delay:${i * 70}ms`}>
          <div class="flex gap-1 text-[var(--color-flame-500)]">
            {Array.from({ length: t.data.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <p class="mt-5 flex-1 text-[var(--color-neutral-700)]">"{t.data.text}"</p>
          <div class="mt-6 flex items-center gap-3 pt-5 border-t border-[var(--color-neutral-100)]">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-ink-950)] text-xs font-semibold text-white">
              {initials(t.data.name)}
            </div>
            <div>
              <p class="text-sm font-semibold text-[var(--color-ink-950)]">{t.data.name}</p>
              <p class="text-xs text-[var(--color-flame-600)]">{t.data.outcome ?? t.data.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
