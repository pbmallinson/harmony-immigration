---
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const bySlug = (slug: string) => services.find((s) => s.data.slug === slug)!;

const arrow = '&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong style="font-size:1.4em; -webkit-text-stroke: 0.6px currentColor;">⟶</strong>';

const pathwayCards = [
  {
    label: 'Work',
    slug: bySlug('work-visas').data.slug,
    icon: '/images/icons-more-than-visa/job-ready.svg',
    desc: `I have a job offer or I've just finished<br class="hidden lg:inline" /> studying and want to work.${arrow}`,
  },
  {
    label: 'Study',
    slug: bySlug('student-visas').data.slug,
    icon: '/images/icons-more-than-visa/english-prep.svg',
    desc: `I'm starting a course or<br class="hidden lg:inline" /> learning English before I do.${arrow}`,
  },
  {
    label: 'Visit',
    slug: bySlug('visitor-visas').data.slug,
    icon: '/images/icons-more-than-visa/visiting.svg',
    desc: `I'm coming for a holiday or to see<br class="hidden lg:inline" /> family, friends or a partner.${arrow}`,
  },
  {
    label: 'Settle',
    slug: bySlug('residence-citizenship').data.slug,
    icon: '/images/icons-more-than-visa/stay-house.svg',
    desc: `I'm skilled or my employer will<br class="hidden lg:inline" /> support my residence.${arrow}`,
  },
];
---

<Page
  title="Services"
  description="Explore Harmony Immigration Services' full range of visa and immigration services: work, family, business, residence, student, and visitor pathways."
>
  <section class="relative overflow-hidden pt-16 pb-32 md:pt-24">
    <div class="container relative z-10 reveal">
      <a href="/#how-we-can-help" class="inline-flex items-center gap-1.5 text-sm font-semibold mb-6" style="color:#55BFC0;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
      </a>
    </div>
    <div class="container relative z-10 reveal mx-auto max-w-2xl text-center md:max-w-4xl">
      <h1 class="md:whitespace-nowrap">Find your pathway</h1>
      <p class="mt-6 text-lg md:whitespace-nowrap">Work, study, visit or stay. Which of these sounds like you?</p>
    </div>
  </section>

  <section class="pb-24 md:pb-32">
    <div class="container">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {pathwayCards.map((card, i) => (
          <a href={`/services/${card.slug}`} class="reveal card card-deep-shadow px-4 py-6" style={`transition-delay:${i * 80}ms; border: 0.7px solid rgba(148, 191, 205, 0.6);`}>
            <div class="flex items-center gap-3">
              <div class="flex h-[52.8px] w-[52.8px] shrink-0 items-center justify-center">
                <img src={card.icon} alt="" class="h-[52.8px] w-[52.8px]" />
              </div>
              <h3 class="tracking-tight whitespace-nowrap">{card.label}</h3>
            </div>
            <p class="mt-2 text-sm" set:html={card.desc} />
          </a>
        ))}
      </div>

      <div class="reveal mx-auto mt-16 flex max-w-[942px] flex-col items-start gap-6 rounded-[var(--radius-xl)] bg-[#123B57] p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <div>
          <p class="text-lg font-semibold text-white whitespace-nowrap">Not sure which of these fits your situation?</p>
          <p class="mt-2 text-lg text-white/80 whitespace-nowrap">Send us a few details and we'll point you in the right direction.</p>
        </div>
        <a href="/contact" class="btn flex-none" style="background:#55BFC0; border-color:#55BFC0; color:white;">Send a message</a>
      </div>
    </div>
  </section>
</Page>
